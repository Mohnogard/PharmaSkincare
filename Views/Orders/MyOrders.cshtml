@model IEnumerable<PharmaSkincare.Models.Order>
@using PharmaSkincare.Models
@{ ViewData["Title"] = "My Orders"; }

<div class="page-header">
    <h1><i class="bi bi-bag-check me-2" style="color:var(--ps-primary);"></i>My Orders</h1>
    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary"><i class="bi bi-shop me-1"></i>Continue Shopping</a>
</div>

@if (!Model.Any())
{
    <div class="form-card text-center py-5">
        <i class="bi bi-bag fs-1 text-muted opacity-50 d-block mb-3"></i>
        <h5>No orders yet</h5>
        <p class="text-muted">Start shopping to place your first order.</p>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Browse Products</a>
    </div>
}
else
{
    @foreach (var order in Model)
    {
        var sc = order.Status switch {
            OrderStatus.Delivered => "bg-success",
            OrderStatus.Shipped => "bg-info",
            OrderStatus.Processing => "bg-primary",
            OrderStatus.Cancelled => "bg-danger",
            OrderStatus.Returned => "bg-danger",
            _ => "bg-warning text-dark"
        };
        <div class="form-card mb-3">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                <div>
                    <h6 class="mb-1 fw-700" style="font-weight:700;">Order #@order.OrderId</h6>
                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@order.OrderDate.ToString("dd MMMM yyyy")</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @sc">@order.Status</span>
                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
            <div class="row g-2">
                @foreach (var item in order.OrderItems.Take(3))
                {
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-2 p-2 border rounded" style="font-size:1.02rem;">
                            <div style="width:32px;height:32px;background:#e8f5f0;border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--ps-primary);">
                                <i class="bi bi-box"></i>
                            </div>
                            <div>
                                <div style="font-weight:600;">@item.Product?.DisplayName</div>
                                <small class="text-muted">Qty: @item.Quantity · JD @item.UnitPrice.ToString("N2")</small>
                            </div>
                        </div>
                    </div>
                }
                @if (order.OrderItems.Count > 3)
                {
                    <div class="col-auto"><div class="d-flex align-items-center p-2 text-muted" style="font-size:1.02rem;">+@(order.OrderItems.Count - 3) more</div></div>
                }
            </div>
            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                <div>
                    @if (order.Shipment != null)
                    {
                        <small class="text-muted"><i class="bi bi-truck me-1"></i>Tracking: <code>@order.Shipment.TrackingNumber</code></small>
                    }
                </div>
                <strong style="color:var(--ps-primary);">JD @((order.TotalAmount + order.ShippingCost - order.DiscountAmount).ToString("N2"))</strong>
            </div>
        </div>
    }
}
