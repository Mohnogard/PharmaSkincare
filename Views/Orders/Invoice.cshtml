@model PharmaSkincare.Models.Order
@{ ViewData["Title"] = $"Invoice #{Model.OrderId}"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice #@Model.OrderId — PharmaSkincare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f8f8f8; margin: 0; padding: 2rem; }
        .invoice-wrap { max-width: 760px; margin: 0 auto; background: #fff; border-radius: 16px; box-shadow: 0 4px 40px rgba(0,0,0,0.08); overflow: hidden; }
        .invoice-header { background: linear-gradient(135deg,#1B4332,#2C6E49); color: #fff; padding: 2.5rem; }
        .brand { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 700; }
        .invoice-label { font-size: 0.96rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
        .invoice-number { font-size: 1.5rem; font-weight: 700; font-family: 'Cormorant Garamond', serif; }
        .invoice-body { padding: 2.5rem; }
        .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem; }
        .meta-label { font-size: 0.96rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #9CA3AF; margin-bottom: 0.25rem; }
        .meta-value { font-size: 1.05rem; color: #1A1A1A; line-height: 1.5; }
        .items-table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
        .items-table th { font-size: 0.96rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF; padding: 0.5rem 0.75rem; border-bottom: 2px solid #F3F4F6; text-align: left; }
        .items-table td { padding: 0.75rem; font-size: 0.984rem; border-bottom: 1px solid #F9FAFB; }
        .items-table td:last-child, .items-table th:last-child { text-align: right; }
        .totals { margin-left: auto; width: 260px; }
        .total-row { display: flex; justify-content: space-between; font-size: 0.984rem; padding: 0.3rem 0; }
        .total-final { display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700; padding: 0.6rem 0; border-top: 2px solid #1A1A1A; margin-top: 0.4rem; font-family: 'Cormorant Garamond', serif; }
        .status-paid { display: inline-flex; align-items: center; gap: 0.4rem; background: #D1FAE5; color: #065F46; border-radius: 50px; font-size: 0.96rem; font-weight: 600; padding: 0.25rem 0.75rem; }
        .status-unpaid { display: inline-flex; align-items: center; gap: 0.4rem; background: #FEF3C7; color: #92400E; border-radius: 50px; font-size: 0.96rem; font-weight: 600; padding: 0.25rem 0.75rem; }
        .invoice-footer { background: #F9FAFB; border-top: 1px solid #F3F4F6; padding: 1.25rem 2.5rem; font-size: 0.96rem; color: #9CA3AF; text-align: center; }
        .print-btn { position: fixed; bottom: 2rem; right: 2rem; background: #2C6E49; color: #fff; border: none; border-radius: 50px; padding: 0.75rem 1.75rem; font-size: 1.08rem; font-weight: 600; cursor: pointer; box-shadow: 0 4px 16px rgba(44,110,73,0.3); }
        @@media print {
            body { background: white; padding: 0; }
            .invoice-wrap { box-shadow: none; border-radius: 0; }
            .print-btn, .back-btn { display: none; }
            .invoice-header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
<div class="invoice-wrap">
    <div class="invoice-header">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="brand">PharmaSkincare</div>
                <div style="font-size:0.96rem;opacity:0.65;margin-top:0.25rem;">Pharmaceutical-grade skincare</div>
            </div>
            <div class="text-end">
                <div class="invoice-label">Invoice</div>
                <div class="invoice-number">#@Model.OrderId</div>
                <div style="font-size:0.96rem;opacity:0.7;margin-top:0.25rem;">@Model.OrderDate.ToString("dd MMMM yyyy")</div>
            </div>
        </div>
    </div>

    <div class="invoice-body">
        <div class="meta-grid">
            <div>
                <div class="meta-label">Bill To</div>
                <div class="meta-value">
                    <strong>@Model.Customer?.FullName</strong><br />
                    @Model.Customer?.Email<br />
                    @if (!string.IsNullOrEmpty(Model.Customer?.PhoneNumber))
                    {
                        @Model.Customer.PhoneNumber<br />
                    }
                </div>
            </div>
            <div>
                <div class="meta-label">Ship To</div>
                <div class="meta-value">
                    @Model.ShippingAddress<br />
                    @Model.City @Model.PostalCode<br />
                    @Model.Country
                </div>
            </div>
            <div>
                <div class="meta-label">Order Status</div>
                <div class="meta-value"><span style="font-weight:600;">@Model.Status</span></div>
            </div>
            <div>
                <div class="meta-label">Payment</div>
                <div class="meta-value">
                    @(Model.PaymentMethod ?? "—")<br />
                    @if (Model.IsPaid)
                    {
                        <span class="status-paid"><i class="bi bi-check-circle"></i>Paid</span>
                    }
                    else
                    {
                        <span class="status-unpaid">Pending</span>
                    }
                </div>
            </div>
        </div>

        <table class="items-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th style="text-align:right;">Unit Price</th>
                    <th style="text-align:right;">Qty</th>
                    <th style="text-align:right;">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td><strong>@item.Product?.DisplayName</strong></td>
                        <td style="color:#9CA3AF;font-size:0.96rem;">@item.Product?.SKU</td>
                        <td style="text-align:right;">JD @item.UnitPrice.ToString("N2")</td>
                        <td style="text-align:right;">@item.Quantity</td>
                        <td style="text-align:right;font-weight:600;">JD @((item.UnitPrice * item.Quantity - item.Discount).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-end">
            <div class="totals">
                <div class="total-row"><span style="color:#6B7280;">Subtotal</span><span>JD @Model.TotalAmount.ToString("N2")</span></div>
                <div class="total-row"><span style="color:#6B7280;">Shipping</span><span>JD @Model.ShippingCost.ToString("N2")</span></div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="total-row"><span style="color:#059669;">Discount</span><span style="color:#059669;">-JD @Model.DiscountAmount.ToString("N2")</span></div>
                }
                <div class="total-final">
                    <span>Total</span>
                    <span style="color:#2C6E49;">JD @((Model.TotalAmount + Model.ShippingCost - Model.DiscountAmount).ToString("N2"))</span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="margin-top:2rem;padding:1rem;background:#F9FAFB;border-radius:10px;">
                <div class="meta-label" style="margin-bottom:0.25rem;">Notes</div>
                <div style="font-size:0.984rem;color:#4B5563;">@Model.Notes</div>
            </div>
        }
    </div>

    <div class="invoice-footer">
        Thank you for your order! For questions, contact support@pharmaskincare.com &nbsp;·&nbsp; PharmaSkincare Ltd, Amman, Jordan
    </div>
</div>

<button class="print-btn no-print" onclick="window.print()">
    <i class="bi bi-printer me-2"></i>Print Invoice
</button>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
</body>
</html>
