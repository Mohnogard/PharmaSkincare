@model PharmaSkincare.ViewModels.DashboardViewModel
@using PharmaSkincare.Models
@{ ViewData["Title"] = "Marketing Dashboard"; }

<div class="page-header">
    <div>
        <h1><i class="bi bi-megaphone me-2" style="color:var(--ps-primary);"></i>Marketing Dashboard</h1>
        <small class="text-muted">Campaign & performance overview — @DateTime.UtcNow.ToString("dddd, dd MMMM yyyy")</small>
    </div>
    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-shop me-1"></i>Visit Store
    </a>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="label mb-2">Active Campaigns</div>
                    <div class="value">@Model.ActiveCampaigns</div>
                    <div class="mt-1 small text-success">running now</div>
                </div>
                <div class="icon-box" style="background:#e8f5f0;color:var(--ps-primary);"><i class="bi bi-megaphone"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="label mb-2">Total Customers</div>
                    <div class="value">@Model.TotalCustomers</div>
                    <div class="mt-1 small text-muted">registered</div>
                </div>
                <div class="icon-box" style="background:#e3f2fd;color:#1976d2;"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="label mb-2">Total Orders</div>
                    <div class="value">@Model.TotalOrders</div>
                    <div class="mt-1 small text-muted">all time</div>
                </div>
                <div class="icon-box" style="background:#fff3e0;color:#f39c12;"><i class="bi bi-receipt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="label mb-2">Monthly Revenue</div>
                    <div class="value">JD @Model.MonthlyRevenue.ToString("N0")</div>
                    <div class="mt-1 small text-muted">JD @Model.TotalRevenue.ToString("N0") total</div>
                </div>
                <div class="icon-box" style="background:#e8f5e9;color:#27ae60;"><i class="bi bi-currency-exchange"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Active Campaigns -->
    <div class="col-lg-7">
        <div class="table-card">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-700"><i class="bi bi-megaphone me-2" style="color:var(--ps-primary);"></i>Active Campaigns</h6>
                <a asp-controller="Marketing" asp-action="Index" class="btn btn-sm btn-outline-primary">Manage</a>
            </div>
            @if (Model.ActiveCampaignsList.Any())
            {
                <table class="table table-hover mb-0">
                    <thead><tr><th>Campaign</th><th>Platform</th><th>Budget</th><th>Conversions</th><th>Ends</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.ActiveCampaignsList)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600;font-size:1.05rem;">@c.Name</div>
                                    @if (!string.IsNullOrEmpty(c.TargetAudience))
                                    {
                                        <small class="text-muted">@c.TargetAudience</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@(c.Platform ?? "—")</span></td>
                                <td>JD @c.Budget.ToString("N0")</td>
                                <td><span class="text-success fw-600" style="font-weight:600;">@c.Conversions</span></td>
                                <td class="text-muted small">@c.EndDate.ToString("dd MMM yyyy")</td>
                                <td><a asp-controller="Marketing" asp-action="Edit" asp-route-id="@c.CampaignId" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-megaphone fs-2 d-block mb-2 opacity-50"></i>
                    No active campaigns.
                    <a asp-controller="Marketing" asp-action="Create" class="btn btn-sm btn-primary mt-2 d-block w-auto mx-auto">Create Campaign</a>
                </div>
            }
        </div>
    </div>

    <!-- Top Products -->
    <div class="col-lg-5">
        <div class="table-card">
            <div class="p-3 border-bottom">
                <h6 class="mb-0 fw-700"><i class="bi bi-trophy me-2" style="color:#f39c12;"></i>Top Selling Products</h6>
            </div>
            @if (Model.TopSellingProducts.Any())
            {
                <div class="p-3">
                    @foreach (var (item, i) in Model.TopSellingProducts.Select((x, i) => (x, i)))
                    {
                        <div class="d-flex align-items-center gap-3 @(i < Model.TopSellingProducts.Count - 1 ? "mb-3 pb-3 border-bottom" : "")">
                            <div style="width:28px;height:28px;background:@(i==0?"#ffd700":i==1?"#c0c0c0":"#cd7f32");border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.96rem;flex-shrink:0;">
                                @(i+1)
                            </div>
                            <div class="flex-grow-1">
                                <div style="font-size:1.05rem;font-weight:600;">@item.ProductName</div>
                                <small class="text-muted">@item.TotalSold units</small>
                            </div>
                            <div style="font-size:1.05rem;font-weight:700;color:var(--ps-primary);">JD @item.Revenue.ToString("N0")</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted"><small>No sales data yet.</small></div>
            }
        </div>
    </div>
</div>

<!-- Revenue trend -->
<div class="chart-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="fw-700 mb-0">Revenue Trend (Last 6 Months)</h6>
        <a asp-controller="Admin" asp-action="Reports" class="btn btn-sm btn-outline-secondary">Full Reports</a>
    </div>
    <canvas id="revenueChart" height="100"></canvas>
</div>

@section Scripts {
<script>
const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueData));
new Chart(document.getElementById('revenueChart'), {
    type: 'line',
    data: {
        labels: revenueData.map(d => d.Month),
        datasets: [{
            label: 'Revenue (JD)',
            data: revenueData.map(d => d.Revenue),
            borderColor: '#1a7a5e', backgroundColor: 'rgba(26,122,94,0.07)',
            borderWidth: 2.5, fill: true, tension: 0.4, pointBackgroundColor: '#1a7a5e', pointRadius: 4
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, grid: { color: '#f0f2f5' }, ticks: { callback: v => 'JD '+v } },
            x: { grid: { display: false } }
        }
    }
});
</script>
}
