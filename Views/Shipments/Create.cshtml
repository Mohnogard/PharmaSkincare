@model PharmaSkincare.ViewModels.ShipmentViewModel
@{ ViewData["Title"] = "Create Shipment"; }

<div class="page-header">
    <h1><i class="bi bi-truck me-2" style="color:var(--ps-primary);"></i>Create Shipment</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="font-size:1.02rem;"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="OrderId" class="form-label"></label>
                        <select asp-for="OrderId" asp-items="Model.Orders" class="form-select">
                            <option value="">-- Select Order --</option>
                        </select>
                        <span asp-validation-for="OrderId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TrackingNumber" class="form-label"></label>
                        <input asp-for="TrackingNumber" class="form-control" placeholder="e.g. GB123456789" />
                        <span asp-validation-for="TrackingNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeliveryCompany" class="form-label"></label>
                        <input asp-for="DeliveryCompany" class="form-control" placeholder="e.g. Aramex, DHL, Jordan Post" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeliveryCost" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">JD</span>
                            <input asp-for="DeliveryCost" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" asp-items="Model.StatusList" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EstimatedDeliveryDate" class="form-label"></label>
                        <input asp-for="EstimatedDeliveryDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Region" class="form-label"></label>
                        <input asp-for="Region" class="form-control" placeholder="e.g. Amman, Jordan" />
                    </div>
                    <div class="col-12">
                        <label asp-for="DeliveryAddress" class="form-label"></label>
                        <textarea asp-for="DeliveryAddress" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Special delivery instructions…"></textarea>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-truck me-1"></i>Create Shipment</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
