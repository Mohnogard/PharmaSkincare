<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PharmaSkincare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --ps-primary: #2C6E49;
            --ps-primary-dark: #1B4332;
            --ps-primary-light: #D8F3DC;
            --ps-cream: #F8F7F4;
            --ps-dark: #1A1A1A;
            --ps-mid: #6B7280;
            --ps-border: #EBEBEB;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html { font-size: 17px; }
        body { background: var(--ps-cream); font-family: 'Inter', sans-serif; font-size: 1.2rem; color: var(--ps-dark); margin: 0; }

        /* ── Sidebar ── */
        #sidebar {
            width: 220px; background: #fff; border-right: 1px solid var(--ps-border);
            position: fixed; top: 0; left: 0; height: 100vh;
            display: flex; flex-direction: column; z-index: 1000; overflow: hidden;
        }
        .sidebar-brand {
            padding: 1.1rem 1rem; border-bottom: 1px solid var(--ps-border); flex-shrink: 0;
        }
        .sidebar-brand-name {
            font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-weight: 700;
            color: var(--ps-dark); line-height: 1.1;
        }
        .sidebar-brand-name span { color: var(--ps-primary); }
        .sidebar-brand-sub { font-size: 1.05rem; color: var(--ps-mid); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 2px; }
        .sidebar-nav-scroll { flex: 1; overflow-y: auto; padding: 0.5rem 0; scrollbar-width: thin; scrollbar-color: #ddd transparent; }
        .sidebar-section {
            font-size: 1.05rem; font-weight: 700; letter-spacing: 0.1em;
            text-transform: uppercase; color: #C4C4BE;
            padding: 0.9rem 1rem 0.2rem;
        }
        .sidebar-nav .nav-link {
            color: var(--ps-mid); padding: 0.5rem 0.6rem 0.5rem 0.85rem;
            display: flex; align-items: center; gap: 0.65rem;
            font-size: 1.08rem; font-weight: 500;
            margin: 0.06rem 0.4rem; border-radius: 6px;
            border-left: 2px solid transparent;
            transition: all 0.15s ease; text-decoration: none;
        }
        .sidebar-nav .nav-link i { font-size: 1.05rem; width: 1.1rem; text-align: center; }
        .sidebar-nav .nav-link:hover { background: var(--ps-primary-light); color: var(--ps-primary); }
        .sidebar-nav .nav-link.active { background: var(--ps-primary-light); color: var(--ps-primary); font-weight: 600; border-left-color: var(--ps-primary); }
        .sidebar-footer {
            flex-shrink: 0; border-top: 1px solid var(--ps-border); padding: 0.75rem 0.85rem;
            display: flex; flex-direction: column; gap: 0.3rem;
        }
        .sidebar-footer .nav-link { color: var(--ps-mid); font-size: 1.08rem; font-weight: 500; display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.5rem; border-radius: 6px; text-decoration: none; }
        .sidebar-footer .nav-link:hover { background: var(--ps-primary-light); color: var(--ps-primary); }
        .sidebar-footer .btn-logout { color: #dc3545; font-size: 1.08rem; font-weight: 500; display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.5rem; border-radius: 6px; background: none; border: none; width: 100%; cursor: pointer; }
        .sidebar-footer .btn-logout:hover { background: #fff5f5; }

        /* ── Topbar ── */
        #topbar {
            margin-left: 220px; background: #fff; border-bottom: 1px solid var(--ps-border);
            padding: 0.55rem 1.5rem; position: sticky; top: 0; z-index: 999;
            display: flex; align-items: center; justify-content: space-between;
        }
        .topbar-user { display: flex; align-items: center; gap: 0.6rem; }
        .topbar-avatar {
            width: 34px; height: 34px; background: var(--ps-primary); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-weight: 600; font-size: 1.08rem; flex-shrink: 0;
        }
        .topbar-name { font-size: 1.08rem; font-weight: 600; color: var(--ps-dark); }
        .topbar-role { font-size: 1.05rem; color: var(--ps-mid); }
        .breadcrumb { font-size: 1.08rem; margin: 0; }
        .breadcrumb-item + .breadcrumb-item::before { color: var(--ps-mid); }

        /* ── Main content ── */
        #main-content { margin-left: 220px; padding: 1.4rem 1.6rem; min-height: 100vh; min-width: 0; }

        /* ── Cards & Components ── */
        .stat-card {
            background: #fff; border-radius: 12px; border: 1px solid var(--ps-border);
            padding: 1.2rem; transition: box-shadow 0.2s;
        }
        .stat-card:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.07); }
        .stat-card .icon-box { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
        .stat-card .value { font-size: 1.7rem; font-weight: 700; color: var(--ps-dark); line-height: 1; font-family: 'Cormorant Garamond', serif; }
        .stat-card .label { font-size: 1.05rem; color: var(--ps-mid); text-transform: uppercase; letter-spacing: 0.06em; }
        .page-header {
            background: #fff; border-radius: 12px; border: 1px solid var(--ps-border);
            padding: 1rem 1.25rem; margin-bottom: 1.25rem;
            display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
        }
        .page-header h1 { font-size: 1.2rem; font-weight: 700; color: var(--ps-dark); margin: 0; font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; }
        .table-card { background: #fff; border-radius: 12px; border: 1px solid var(--ps-border); overflow: hidden; }
        .table-card .table { margin: 0; }
        .table-card .table th { background: #FAFAF8; font-size: 1.05rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ps-mid); border-bottom: 1px solid var(--ps-border); padding: 0.75rem 0.9rem; }
        .table-card .table td { padding: 0.7rem 0.9rem; vertical-align: middle; border-color: #F5F5F3; font-size: 1.08rem; }
        .table-card .table tbody tr:hover { background: #FAFAF8; }
        .form-card { background: #fff; border-radius: 12px; border: 1px solid var(--ps-border); padding: 1.25rem; }
        .chart-card { background: #fff; border-radius: 12px; border: 1px solid var(--ps-border); padding: 1.1rem; }
        .form-label { font-weight: 500; font-size: 1.08rem; color: #374151; }
        .form-control, .form-select { border-color: #E0E0DC; border-radius: 8px; font-size: 1.08rem; padding: 0.5rem 0.8rem; }
        .form-control:focus, .form-select:focus { border-color: var(--ps-primary); box-shadow: 0 0 0 3px rgba(44,110,73,0.1); }
        .btn-primary { background: var(--ps-primary); border-color: var(--ps-primary); font-size: 1.08rem; }
        .btn-primary:hover { background: var(--ps-primary-dark); border-color: var(--ps-primary-dark); }
        .btn-outline-primary { color: var(--ps-primary); border-color: var(--ps-primary); font-size: 1.08rem; }
        .btn-outline-primary:hover { background: var(--ps-primary); border-color: var(--ps-primary); }
        .badge-status { font-size: 1.05rem; padding: 0.28em 0.65em; border-radius: 50px; font-weight: 500; }
        .product-img { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; background: var(--ps-primary-light); }
        .stock-low { color: #dc3545; font-weight: 600; }
        .stock-ok { color: var(--ps-primary); }
        .alert-success, .alert-info { border: none; }

        /* ── Mobile ── */
        @@media (max-width: 991.98px) {
            #sidebar { transform: translateX(-100%); transition: transform 0.25s ease; }
            #sidebar.show { transform: translateX(0); box-shadow: 4px 0 24px rgba(0,0,0,0.12); }
            #topbar, #main-content { margin-left: 0; }
        }
        @@media (max-width: 991.98px) {
            .table-card { overflow-x: auto; }
            .table-card .table { min-width: 560px; }
            #main-content { padding: 1rem 0.85rem; }
        }
        @@media (max-width: 576px) {
            .stat-card .value { font-size: 1.4rem; }
            #main-content { padding: 0.75rem 0.6rem; }
            .page-header { padding: 0.75rem 0.9rem; }
            .page-header h1 { font-size: 1.25rem; }
        }
    </style>
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <nav id="sidebar">
        <div class="sidebar-brand">
            <a asp-controller="Shop" asp-action="Index" style="text-decoration:none;">
                <div class="sidebar-brand-name">Pharma<span>Skincare</span></div>
                <div class="sidebar-brand-sub">Management Platform</div>
            </a>
        </div>

        <div class="sidebar-nav-scroll">
            <div class="sidebar-nav">

                <div class="sidebar-section">Overview</div>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>

                @if (User.IsInRole("Customer"))
                {
                    <div class="sidebar-section">My Shopping</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Shop" ? "active" : "")"
                       asp-controller="Shop" asp-action="Index">
                        <i class="bi bi-shop"></i> Browse Products
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "MyOrders" ? "active" : "")"
                       asp-controller="Orders" asp-action="MyOrders">
                        <i class="bi bi-bag-check"></i> My Orders
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="sidebar-section">Operations</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")"
                       asp-controller="Products" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Products
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Categories" ? "active" : "")"
                       asp-controller="Admin" asp-action="Categories">
                        <i class="bi bi-tags"></i> Categories
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.StartsWith("Subcategor") == true ? "active" : "")"
                       asp-controller="Admin" asp-action="Subcategories">
                        <i class="bi bi-collection"></i> Subcategories
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" ? "active" : "")"
                       asp-controller="Inventory" asp-action="Index">
                        <i class="bi bi-archive"></i> Inventory
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Orders" ? "active" : "")"
                       asp-controller="Orders" asp-action="Index">
                        <i class="bi bi-receipt"></i> Orders
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Shipments" ? "active" : "")"
                       asp-controller="Shipments" asp-action="Index">
                        <i class="bi bi-truck"></i> Shipments
                    </a>

                    <div class="sidebar-section">Marketing</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Campaigns" ? "active" : "")"
                       asp-controller="Marketing" asp-action="Campaigns">
                        <i class="bi bi-megaphone"></i> Campaigns
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Doctors" ? "active" : "")"
                       asp-controller="Marketing" asp-action="Doctors">
                        <i class="bi bi-person-badge"></i> Doctors
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Endorsements" ? "active" : "")"
                       asp-controller="Marketing" asp-action="Endorsements">
                        <i class="bi bi-award"></i> Endorsements
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Partners" ? "active" : "")"
                       asp-controller="Marketing" asp-action="Partners">
                        <i class="bi bi-building"></i> Pharmacy Partners
                    </a>

                    <div class="sidebar-section">Compliance</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Certificates" ? "active" : "")"
                       asp-controller="Certificates" asp-action="Index">
                        <i class="bi bi-shield-check"></i> Certificates
                    </a>

                    <div class="sidebar-section">Administration</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" ? "active" : "")"
                       asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people"></i> Users
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Reports" ? "active" : "")"
                       asp-controller="Admin" asp-action="Reports">
                        <i class="bi bi-bar-chart"></i> Reports
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ActivityLogs" ? "active" : "")"
                       asp-controller="Admin" asp-action="ActivityLogs">
                        <i class="bi bi-clock-history"></i> Activity Logs
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PendingContent" ? "active" : "")"
                       asp-controller="Admin" asp-action="PendingContent">
                        <i class="bi bi-shield-exclamation"></i> Content Approval
                    </a>
                }
            </div>
        </div>

        <div class="sidebar-footer">
            <a class="nav-link" asp-controller="Shop" asp-action="Index">
                <i class="bi bi-shop"></i> Visit Store
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")"
               asp-controller="Account" asp-action="Profile">
                <i class="bi bi-person-circle"></i> My Profile
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <i class="bi bi-box-arrow-left"></i> Sign Out
                </button>
            </form>
        </div>
    </nav>

    <div id="topbar">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm border-0 d-lg-none p-1" id="sidebarToggle">
                <i class="bi bi-list fs-5"></i>
            </button>
            <nav aria-label="breadcrumb" class="d-none d-md-block">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none" style="color:var(--ps-mid);">PharmaSkincare</a>
                    </li>
                    <li class="breadcrumb-item active" style="color:var(--ps-dark);">@ViewData["Title"]</li>
                </ol>
            </nav>
        </div>
        <div class="topbar-user">
            @{
                var uName = User.Identity?.Name ?? "";
                var uInitial = uName.Length > 0 ? uName[0].ToString().ToUpper() : "U";
                var uRole = User.IsInRole("Admin") ? "Administrator" : "Customer";
            }
            <div class="topbar-avatar">@uInitial</div>
            <div class="d-none d-md-block">
                <div class="topbar-name">@uName</div>
                <div class="topbar-role">@uRole</div>
            </div>
        </div>
    </div>

    <main id="main-content">
        @RenderBody()
    </main>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', () =>
        document.getElementById('sidebar')?.classList.toggle('show'));
    document.addEventListener('click', e => {
        const sidebar = document.getElementById('sidebar');
        const toggle = document.getElementById('sidebarToggle');
        if (sidebar?.classList.contains('show') && !sidebar.contains(e.target) && !toggle?.contains(e.target))
            sidebar.classList.remove('show');
    });
    // SweetAlert2 logout confirm
    document.querySelectorAll('.btn-logout').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            Swal.fire({
                title: 'Sign out?',
                text: 'You will need to sign in again to access your account.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2C6E49',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, sign out',
                cancelButtonText: 'Cancel'
            }).then(r => { if (r.isConfirmed) form.submit(); });
        });
    });
    @if (TempData["Success"] != null)
    {
        <text>Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())), showConfirmButton: false, timer: 4000, timerProgressBar: true });</text>
    }
    @if (TempData["Error"] != null)
    {
        <text>Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())), showConfirmButton: true, confirmButtonColor: '#2C6E49' });</text>
    }
    @if (TempData["Info"] != null)
    {
        <text>Swal.fire({ toast: true, position: 'top-end', icon: 'info', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Info"]?.ToString())), showConfirmButton: false, timer: 5000, timerProgressBar: true });</text>
    }
    // SweetAlert confirm for any delete/danger actions
    document.querySelectorAll('[data-swal-confirm]').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const msg = this.dataset.swalConfirm || 'Are you sure?';
            const form = this.closest('form') || document.getElementById(this.dataset.swalForm);
            Swal.fire({ title: 'Are you sure?', text: msg, icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#dc3545', cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, proceed', cancelButtonText: 'Cancel'
            }).then(r => { if (r.isConfirmed && form) form.submit(); else if (r.isConfirmed && this.href) location.href = this.href; });
        });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
