<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function initDropdowns() {
        document.querySelectorAll('[data-dropdown]').forEach(trigger => {
            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                const wrap = document.getElementById(this.dataset.dropdown);
                const isOpen = wrap.classList.contains('open');
                closeAll();
                if (!isOpen) wrap.classList.add('open');
            });
        });
        document.addEventListener('click', closeAll);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });
    }
    function closeAll() {
        document.querySelectorAll('.nav-dropdown-wrap.open').forEach(w => w.classList.remove('open'));
    }
    const mobileBtn     = document.getElementById('mobileMenuBtn');
    const closeBtn      = document.getElementById('closeMobileMenu');
    const mobileMenu    = document.getElementById('mobileMenu');
    const mobileOverlay = document.getElementById('mobileOverlay');
    function openDrawer()  {
        mobileMenu?.classList.add('open');
        mobileOverlay?.classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
        mobileMenu?.classList.remove('open');
        mobileOverlay?.classList.remove('open');
        document.body.style.overflow = '';
    }
    mobileBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    mobileOverlay?.addEventListener('click', closeDrawer);
    initDropdowns();
    @if (TempData["Success"] != null)
    {
        <text>Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())), showConfirmButton: false, timer: 2000, timerProgressBar: true, width: 'auto' });</text>
    }
    @if (TempData["Error"] != null)
    {
        <text>Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())), showConfirmButton: true, confirmButtonColor: '#2C6E49', width: 'auto' });</text>
    }
    @if (TempData["Info"] != null)
    {
        <text>Swal.fire({ toast: true, position: 'top-end', icon: 'info', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Info"]?.ToString())), showConfirmButton: false, timer: 3000, timerProgressBar: true, width: 'auto' });</text>
    }
    // ── AJAX add-to-basket ──
    function psCartToast(msg, ok) {
        Swal.fire({ toast: true, position: 'top-end', icon: ok ? 'success' : 'error',
            title: msg, showConfirmButton: false, timer: 2000, timerProgressBar: true, width: 'auto' });
    }
    function psUpdateCartBadge(count) {
        const badge = document.getElementById('cart-badge');
        if (!badge) return;
        badge.textContent = count > 9 ? '9+' : count;
        badge.style.display = count > 0 ? '' : 'none';
    }
    document.addEventListener('submit', function(e) {
        const form = e.target;
        if (!form.matches('form[action*="/Cart/Add"]') && !form.action?.includes('/Cart/Add')) return;
        e.preventDefault();
        fetch(form.action || '/Cart/Add', {
            method: 'POST',
            headers: { 'X-Ajax-Cart': '1' },
            body: new FormData(form)
        })
        .then(r => r.json())
        .then(d => { psCartToast(d.message, d.success); if (d.success) psUpdateCartBadge(d.cartCount); })
        .catch(() => psCartToast('Could not reach server.', false));
    });
    // ── Currency conversion (JD base) ──
    const PS_CURRENCIES = {
        JOD: { symbol: 'JD ', rate: 1.00 },
        USD: { symbol: '$',   rate: 1.41 },
        EUR: { symbol: '€',   rate: 1.30 }
    };
    let _psCcInit = false;
    function psCurrencyInit() {
        if (_psCcInit) return; _psCcInit = true;
        const root = document.querySelector('main.shop-main') || document.body;
        const nodes = [];
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode(n) {
                const p = n.parentElement;
                if (!p) return NodeFilter.FILTER_REJECT;
                if (['SCRIPT','STYLE','TEXTAREA','INPUT','CODE'].includes(p.tagName)) return NodeFilter.FILTER_REJECT;
                if (p.classList && p.classList.contains('ps-price')) return NodeFilter.FILTER_REJECT;
                return /JD \d/.test(n.textContent) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
            }
        });
        let nd;
        while ((nd = walker.nextNode())) nodes.push(nd);
        nodes.forEach(tn => {
            const parts = tn.textContent.split(/(JD [\d,]+\.?\d*)/);
            if (parts.length < 2) return;
            const frag = document.createDocumentFragment();
            parts.forEach(part => {
                const m = part.match(/^JD ([\d,]+\.?\d*)$/);
                if (m) {
                    const s = document.createElement('span');
                    s.className = 'ps-price';
                    s.dataset.jod = parseFloat(m[1].replace(/,/g, ''));
                    s.textContent = part;
                    frag.appendChild(s);
                } else {
                    frag.appendChild(document.createTextNode(part));
                }
            });
            tn.parentNode.replaceChild(frag, tn);
        });
    }
    function psSetCurrency(code) {
        const c = PS_CURRENCIES[code]; if (!c) return;
        psCurrencyInit();
        document.querySelectorAll('.ps-price').forEach(el => {
            el.textContent = c.symbol + (parseFloat(el.dataset.jod) * c.rate).toFixed(2);
        });
        const lbl = document.getElementById('currencyLabel');
        if (lbl) lbl.textContent = code === 'JOD' ? 'JD' : code;
        document.querySelectorAll('.currency-option').forEach(btn => btn.classList.toggle('active', btn.dataset.currency === code));
        localStorage.setItem('ps_currency', code);
    }
    document.querySelectorAll('.currency-option').forEach(btn => {
        btn.addEventListener('click', function() { psSetCurrency(this.dataset.currency); closeAll(); });
    });
    psSetCurrency(localStorage.getItem('ps_currency') || 'JOD');

    // SweetAlert2 logout confirm
    document.querySelectorAll('.dropdown-signout').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            Swal.fire({
                title: 'Sign out?',
                text: 'You will be returned to the store.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2C6E49',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, sign out',
                cancelButtonText: 'Stay'
            }).then(r => { if (r.isConfirmed) form.submit(); });
        });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
