@model List<PharmaSkincare.Models.Category>
@{ ViewData["Title"] = "Categories"; }

<div class="page-header">
    <div>
        <h1><i class="bi bi-tags me-2" style="color:var(--ps-primary);"></i>Categories</h1>
        <small class="text-muted">Manage product categories. Deactivating a category soft-deletes all its products.</small>
    </div>
    <a asp-action="CreateCategory" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Category</a>
</div>

<div class="table-card">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th class="text-center">Products</th>
                <th>Created</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                var activeCount = cat.Subcategories.Sum(s => s.Products.Count(p => p.IsActive));
                var totalCount  = cat.Subcategories.Sum(s => s.Products.Count);
                <tr>
                    <td class="fw-600">@cat.Name</td>
                    <td style="color:var(--ps-mid);max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        @(cat.Description ?? "—")
                    </td>
                    <td class="text-center">
                        <span class="badge bg-light text-dark border">@activeCount active / @totalCount total</span>
                    </td>
                    <td style="color:var(--ps-mid);">@cat.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (cat.IsActive)
                        {
                            <span class="badge-status" style="background:#d1fae5;color:#065f46;">Active</span>
                        }
                        else
                        {
                            <span class="badge-status" style="background:#fee2e2;color:#991b1b;">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="EditCategory" asp-route-id="@cat.CategoryId" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="ToggleCategory" asp-route-id="@cat.CategoryId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (cat.IsActive)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-swal-confirm="This will deactivate all @totalCount product(s) in '@cat.Name'. They will be restored if you reactivate the category."
                                        data-swal-form="">
                                    <i class="bi bi-eye-slash"></i> Deactivate
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-eye"></i> Restore
                                </button>
                            }
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-4 text-muted">No categories yet. <a asp-action="CreateCategory">Add the first one.</a></td></tr>
            }
        </tbody>
    </table>
</div>
