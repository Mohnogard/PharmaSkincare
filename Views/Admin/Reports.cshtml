@model PharmaSkincare.ViewModels.ReportsViewModel
@{ ViewData["Title"] = "Reports & Analytics"; }

<div class="page-header">
    <h1><i class="bi bi-bar-chart me-2" style="color:var(--ps-primary);"></i>Reports & Analytics</h1>
    <a asp-action="ExportInventory" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-excel me-1"></i>Export Inventory (Excel)
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div><div class="label mb-2">Total Revenue</div><div class="value">JD @Model.TotalRevenue.ToString("N0")</div></div>
                <div class="icon-box" style="background:#e8f5e9;color:#27ae60;"><i class="bi bi-currency-exchange"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div><div class="label mb-2">Total Orders</div><div class="value">@Model.TotalOrders</div></div>
                <div class="icon-box" style="background:#fff3e0;color:#f39c12;"><i class="bi bi-receipt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div><div class="label mb-2">Active Products</div><div class="value">@Model.TotalProducts</div></div>
                <div class="icon-box" style="background:#e8f5f0;color:var(--ps-primary);"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div><div class="label mb-2">On-Time Delivery</div><div class="value">@Model.ShipmentOnTimeRate%</div></div>
                <div class="icon-box" style="background:#e3f2fd;color:#1976d2;"><i class="bi bi-truck"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="chart-card">
            <h6 class="fw-700 mb-3" style="font-weight:700;">
                <i class="bi bi-graph-up me-2" style="color:var(--ps-primary);"></i>Monthly Revenue (Last 6 Months)
            </h6>
            <canvas id="revenueChart" height="110"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card h-100">
            <h6 class="fw-700 mb-3" style="font-weight:700;">
                <i class="bi bi-pie-chart me-2" style="color:#f39c12;"></i>Order Status Breakdown
            </h6>
            @if (Model.OrderStatusBreakdown.Any())
            {
                <canvas id="statusChart" height="200"></canvas>
            }
            else
            {
                <div class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>No orders yet</div>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="chart-card">
            <h6 class="fw-700 mb-3" style="font-weight:700;">
                <i class="bi bi-trophy me-2" style="color:#f39c12;"></i>Top 5 Products by Revenue
            </h6>
            @if (Model.TopSellingProducts.Any())
            {
                <canvas id="topProductsChart" height="160"></canvas>
            }
            else
            {
                <div class="text-center text-muted py-5"><i class="bi bi-box-seam fs-2 d-block mb-2"></i>No sales data yet</div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="chart-card h-100 d-flex flex-column">
            <h6 class="fw-700 mb-3" style="font-weight:700;">
                <i class="bi bi-speedometer2 me-2" style="color:var(--ps-primary);"></i>Quick Stats
            </h6>
            <div class="mb-3 pb-3 border-bottom">
                <div class="text-muted small mb-1">Total Registered Users</div>
                <div style="font-size:1.5rem;font-weight:700;color:var(--ps-primary);">@Model.TotalCustomers</div>
            </div>
            <div class="mb-3 pb-3 border-bottom">
                <div class="text-muted small mb-1">Shipment On-Time Rate</div>
                <div style="font-size:1.5rem;font-weight:700;color:#27ae60;">@Model.ShipmentOnTimeRate%</div>
                <div class="progress mt-1" style="height:6px;border-radius:3px;">
                    <div class="progress-bar bg-success" style="width:@Model.ShipmentOnTimeRate%;border-radius:3px;"></div>
                </div>
            </div>
            <div class="mb-3 pb-3 border-bottom">
                <div class="text-muted small mb-2">Top Revenue Categories</div>
                @foreach (var cat in Model.TopCategories)
                {
                    <div class="d-flex justify-content-between py-1">
                        <span class="small">@cat.Category</span>
                        <strong class="small" style="color:var(--ps-primary);">JD @cat.Revenue.ToString("N0")</strong>
                    </div>
                }
            </div>
            <div class="mt-auto pt-2">
                <div class="text-muted small mb-2 fw-600">Detailed Reports</div>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Orders" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2 p-2 rounded border hover-shadow small">
                        <i class="bi bi-receipt" style="color:var(--ps-primary);font-size:1.1rem;"></i> Order Report
                    </a>
                    <a asp-controller="Inventory" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2 p-2 rounded border small">
                        <i class="bi bi-archive" style="color:#1976d2;font-size:1.1rem;"></i> Inventory Report
                    </a>
                    <a asp-controller="Shipments" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2 p-2 rounded border small">
                        <i class="bi bi-truck" style="color:#27ae60;font-size:1.1rem;"></i> Shipment Report
                    </a>
                    <a asp-controller="Certificates" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2 p-2 rounded border small">
                        <i class="bi bi-shield-check" style="color:#f39c12;font-size:1.1rem;"></i> Compliance Report
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    const psGreen = '#1a7a5e';
    const psGreenLight = 'rgba(26,122,94,0.15)';

    // Monthly Revenue Bar Chart
    const revenueCtx = document.getElementById('revenueChart');
    if (revenueCtx) {
        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.MonthlyRevenueData.Select(m => $"'{m.Month}'")))],
                datasets: [{
                    label: 'Revenue (JD)',
                    data: [@string.Join(",", Model.MonthlyRevenueData.Select(m => m.Revenue))],
                    backgroundColor: 'rgba(26,122,94,0.75)',
                    borderColor: psGreen,
                    borderWidth: 1,
                    borderRadius: 4
                }, {
                    label: 'Orders',
                    data: [@string.Join(",", Model.MonthlyRevenueData.Select(m => m.Orders))],
                    backgroundColor: 'rgba(243,156,18,0.65)',
                    borderColor: '#f39c12',
                    borderWidth: 1,
                    borderRadius: 4,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => 'JD ' + v.toLocaleString() } },
                    y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { stepSize: 1 } }
                }
            }
        });
    }

    // Order Status Doughnut
    const statusCtx = document.getElementById('statusChart');
    if (statusCtx) {
        const statusColors = {
            'Pending': '#f39c12', 'Processing': '#3498db', 'Packed': '#9b59b6',
            'Shipped': '#1abc9c', 'Delivered': '#27ae60', 'Cancelled': '#e74c3c', 'Returned': '#95a5a6'
        };
        const statusLabels = [@Html.Raw(string.Join(",", Model.OrderStatusBreakdown.Select(s => $"'{s.Status}'")))];
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: [@string.Join(",", Model.OrderStatusBreakdown.Select(s => s.Count))],
                    backgroundColor: statusLabels.map(l => statusColors[l] || '#aaa'),
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10 } }
                }
            }
        });
    }

    // Top Products Horizontal Bar
    const productsCtx = document.getElementById('topProductsChart');
    if (productsCtx) {
        new Chart(productsCtx, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.TopSellingProducts.Select(p => $"'{p.ProductName.Replace("'", "\\'")}'") ))],
                datasets: [{
                    label: 'Revenue (JD)',
                    data: [@string.Join(",", Model.TopSellingProducts.Select(p => p.Revenue))],
                    backgroundColor: [
                        'rgba(26,122,94,0.80)', 'rgba(26,122,94,0.65)', 'rgba(26,122,94,0.50)',
                        'rgba(26,122,94,0.38)', 'rgba(26,122,94,0.25)'
                    ],
                    borderColor: psGreen,
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { beginAtZero: true, ticks: { callback: v => 'JD ' + v.toLocaleString() } }
                }
            }
        });
    }
</script>
