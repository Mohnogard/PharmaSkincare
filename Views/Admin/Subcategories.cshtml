@model List<PharmaSkincare.Models.Subcategory>
@using PharmaSkincare.Models
@{
    ViewData["Title"] = "Subcategories";
    var cats = ViewBag.Categories as List<Category> ?? new();
    var selCat = ViewBag.SelectedCategoryId as int?;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-collection me-2" style="color:var(--ps-primary);"></i>Subcategories</h1>
        <small class="text-muted">Each subcategory is a product line. Its size type is fixed once products are added.</small>
    </div>
    <a asp-action="CreateSubcategory" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Subcategory</a>
</div>

<!-- Category filter -->
<div class="d-flex gap-2 mb-3 flex-wrap">
    <a asp-action="Subcategories" class="btn btn-sm @(!selCat.HasValue ? "btn-primary" : "btn-outline-secondary")">All</a>
    @foreach (var cat in cats)
    {
        <a asp-action="Subcategories" asp-route-categoryId="@cat.CategoryId"
           class="btn btn-sm @(selCat == cat.CategoryId ? "btn-primary" : "btn-outline-secondary")">@cat.Name</a>
    }
</div>

<div class="table-card">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Category</th>
                <th>Name</th>
                <th>Size Type</th>
                <th>Format</th>
                <th class="text-center">Products</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sub in Model)
            {
                var activeCount = sub.Products.Count(p => p.IsActive);
                var totalCount  = sub.Products.Count;
                <tr>
                    <td style="color:var(--ps-mid);font-size:0.96rem;">@sub.Category?.Name</td>
                    <td class="fw-600">@sub.Name</td>
                    <td>
                        @switch (sub.SizeType)
                        {
                            case SizeType.Ml:
                                <span class="badge" style="background:#DBEAFE;color:#1D4ED8;font-size:0.88rem;">ml</span>
                                break;
                            case SizeType.Pills:
                                <span class="badge" style="background:#D1FAE5;color:#065F46;font-size:0.88rem;">pills</span>
                                break;
                            default:
                                <span class="badge" style="background:#F3F4F6;color:#6B7280;font-size:0.88rem;">none</span>
                                break;
                        }
                    </td>
                    <td style="color:var(--ps-mid);font-size:0.96rem;">@sub.ProductFormat</td>
                    <td class="text-center">
                        <span class="badge bg-light text-dark border">@activeCount active / @totalCount total</span>
                    </td>
                    <td>
                        @if (sub.IsActive)
                        {
                            <span class="badge-status" style="background:#d1fae5;color:#065f46;">Active</span>
                        }
                        else
                        {
                            <span class="badge-status" style="background:#fee2e2;color:#991b1b;">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="EditSubcategory" asp-route-id="@sub.SubcategoryId" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="ToggleSubcategory" asp-route-id="@sub.SubcategoryId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (sub.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-swal-confirm="This will deactivate all @totalCount product variant(s) in '@sub.Name'."
                                        data-swal-form="">
                                    <i class="bi bi-eye-slash"></i> Deactivate
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-eye"></i> Restore
                                </button>
                            }
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-4 text-muted">No subcategories yet. <a asp-action="CreateSubcategory">Create the first one.</a></td></tr>
            }
        </tbody>
    </table>
    @{
        int subCurPage = ViewBag.CurrentPage ?? 1;
        int subTotalPages = ViewBag.TotalPages ?? 1;
        int subTotal = ViewBag.TotalCount ?? 0;
    }
    @if (subTotalPages > 1)
    {
        <div class="px-3 py-2 border-top d-flex align-items-center justify-content-between">
            <small class="text-muted">Page @subCurPage of @subTotalPages (@subTotal records)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @if (subCurPage > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Subcategories" asp-route-page="@(subCurPage-1)" asp-route-categoryId="@ViewBag.SelectedCategoryId">‹</a></li>
                    }
                    @for (int i = Math.Max(1, subCurPage - 2); i <= Math.Min(subTotalPages, subCurPage + 2); i++)
                    {
                        <li class="page-item @(i == subCurPage ? "active" : "")">
                            <a class="page-link" asp-action="Subcategories" asp-route-page="@i" asp-route-categoryId="@ViewBag.SelectedCategoryId">@i</a>
                        </li>
                    }
                    @if (subCurPage < subTotalPages)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Subcategories" asp-route-page="@(subCurPage+1)" asp-route-categoryId="@ViewBag.SelectedCategoryId">›</a></li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
