@using PharmaSkincare.Models
@{ ViewData["Title"] = "Content Approval"; }

<div class="page-header">
    <div>
        <h1><i class="bi bi-shield-exclamation me-2" style="color:var(--ps-primary);"></i>Content Approval</h1>
        <small class="text-muted">Review and approve pending reviews, testimonials, and contact messages</small>
    </div>
</div>

@{
    var reviews      = ViewBag.PendingReviews      as List<ProductReview>   ?? new();
    var testimonials = ViewBag.PendingTestimonials as List<Testimonial>     ?? new();
    var contacts     = ViewBag.ContactMessages     as List<ContactMessage>  ?? new();
}

<!-- Pending Reviews -->
<div class="table-card mb-4">
    <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-700">
            <i class="bi bi-star me-2" style="color:#F59E0B;"></i>Pending Product Reviews
            @if (reviews.Any()) { <span class="badge bg-warning text-dark ms-2">@reviews.Count</span> }
        </h6>
    </div>
    @if (reviews.Any())
    {
        <table class="table table-hover mb-0">
            <thead><tr><th>Product</th><th>Customer</th><th>Rating</th><th>Comment</th><th>Date</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in reviews)
                {
                    <tr>
                        <td style="font-weight:600;">@r.Product?.DisplayName</td>
                        <td>@r.Customer?.FullName</td>
                        <td><span style="color:#F59E0B;">@string.Concat(Enumerable.Repeat("★", r.Rating))</span></td>
                        <td style="max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@r.Comment</td>
                        <td class="text-muted small">@r.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-action="ApproveReview" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.ReviewId" />
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Approve</button>
                                </form>
                                <form asp-action="RejectReview" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.ReviewId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Remove</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>No pending reviews.
        </div>
    }
</div>

<!-- Pending Testimonials -->
<div class="table-card mb-4">
    <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-700">
            <i class="bi bi-chat-quote me-2" style="color:var(--ps-primary);"></i>Pending Testimonials
            @if (testimonials.Any()) { <span class="badge bg-warning text-dark ms-2">@testimonials.Count</span> }
        </h6>
    </div>
    @if (testimonials.Any())
    {
        <div class="p-3">
            @foreach (var t in testimonials)
            {
                <div style="border:1px solid var(--ps-border);border-radius:12px;padding:1.25rem;margin-bottom:0.75rem;">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div style="flex:1;">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <strong style="font-size:1.08rem;">@t.Title</strong>
                                <span style="color:#F59E0B;font-size:1.02rem;">@string.Concat(Enumerable.Repeat("★", t.Rating))</span>
                            </div>
                            <p style="font-size:1.02rem;color:#4B5563;margin-bottom:0.5rem;line-height:1.6;">@t.Content</p>
                            <small class="text-muted">By @t.AuthorName · @t.CreatedDate.ToString("dd MMM yyyy")</small>
                        </div>
                        <div class="d-flex gap-2 flex-shrink-0">
                            <form asp-action="ApproveTestimonial" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.TestimonialId" />
                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Approve</button>
                            </form>
                            <form asp-action="RejectTestimonial" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.TestimonialId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>No pending testimonials.
        </div>
    }
</div>

<!-- Contact Messages -->
<div class="table-card">
    <div class="p-3 border-bottom">
        <h6 class="mb-0 fw-700">
            <i class="bi bi-envelope me-2" style="color:var(--ps-primary);"></i>Recent Contact Messages
        </h6>
    </div>
    @if (contacts.Any())
    {
        <table class="table table-hover mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Subject</th><th>Message</th><th>Date</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in contacts)
                {
                    <tr class="@(!m.IsRead ? "table-warning" : "")">
                        <td style="font-weight:600;">@m.Name</td>
                        <td><a href="mailto:@m.Email" style="color:var(--ps-primary);">@m.Email</a></td>
                        <td>@m.Subject</td>
                        <td style="max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:0.984rem;color:var(--ps-mid);">@m.Message</td>
                        <td class="text-muted small">@m.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (m.IsRead) { <span class="badge bg-secondary">Read</span> }
                            else { <span class="badge bg-warning text-dark">New</span> }
                        </td>
                        <td>
                            @if (!m.IsRead)
                            {
                                <form asp-action="MarkContactRead" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.ContactMessageId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Read</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="p-4 text-center text-muted">No contact messages yet.</div>
    }
</div>
