@model IEnumerable<PharmaSkincare.Models.ActivityLog>
@{ ViewData["Title"] = "Activity Logs"; }

<div class="page-header">
    <div>
        <h1><i class="bi bi-clock-history me-2" style="color:var(--ps-primary);"></i>Activity Logs</h1>
        <small class="text-muted">@ViewBag.TotalCount total events</small>
    </div>
</div>

<div class="table-card">
    <table class="table table-hover mb-0">
        <thead>
            <tr><th>Timestamp</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td class="text-muted small">@log.Timestamp.ToString("dd MMM yyyy HH:mm:ss")</td>
                    <td>
                        <div style="font-size:1.05rem;font-weight:600;">@(log.User?.FullName ?? "System")</div>
                        <small class="text-muted">@log.User?.Email</small>
                    </td>
                    <td style="font-size:1.05rem;">
                        <i class="bi bi-activity me-1" style="color:var(--ps-primary);"></i>@log.Action
                    </td>
                    <td class="text-muted small">
                        @if (!string.IsNullOrEmpty(log.EntityType))
                        {
                            <span class="badge bg-light text-dark border">@log.EntityType @(log.EntityId.HasValue ? $"#{log.EntityId}" : "")</span>
                        }
                    </td>
                    <td class="text-muted small" style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@log.Details">
                        @(log.Details ?? "—")
                    </td>
                    <td class="text-muted small"><code>@(log.IpAddress ?? "—")</code></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-5 text-muted"><i class="bi bi-clock-history fs-1 d-block mb-2 opacity-25"></i>No activity logs yet.</td></tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="px-3 py-2 border-top d-flex align-items-center justify-content-between">
            <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages (@ViewBag.TotalCount records)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="ActivityLogs" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
