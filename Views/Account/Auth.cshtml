@model PharmaSkincare.ViewModels.AuthViewModel
@{ Layout = null; ViewData["Title"] = Model.ActiveTab == "register" ? "Create Account" : "Sign In"; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PharmaSkincare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        html { font-size: 19px; }
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif; background: #F9FAF8; min-height: 100vh; display: flex; }

        /* ── Left panel (fixed — same for both tabs) ── */
        .auth-left {
            flex: 0 0 50%;
            min-height: 100vh;
            position: relative; overflow: hidden;
            background:
                linear-gradient(to top, rgba(27,67,50,0.93) 0%, rgba(27,67,50,0.40) 50%, rgba(27,67,50,0.15) 100%),
                url('/assets/images/happy1.jpg') center top / cover no-repeat;
            display: flex; flex-direction: column; justify-content: flex-end; padding: 3rem;
        }
        .auth-left-content { position: relative; z-index: 1; }

        .auth-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.1rem; font-weight: 700; color: #fff;
            text-decoration: none; letter-spacing: -0.02em; display: block; margin-bottom: 1rem;
        }
        .auth-brand em { color: #74C69D; font-style: normal; }
        .auth-quote {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.45rem; font-weight: 600; color: #fff;
            line-height: 1.4; max-width: 330px; margin-bottom: 0.6rem;
        }
        .auth-tagline { font-size: 1.2rem; color: rgba(255,255,255,0.65); line-height: 1.6; max-width: 320px; }
        .auth-features { margin-top: 1.75rem; display: flex; flex-direction: column; gap: 0.85rem; }
        .auth-feature { display: flex; align-items: center; gap: 0.85rem; color: rgba(255,255,255,0.85); font-size: 1.2rem; }
        .auth-feature i { color: #74C69D; font-size: 1.5rem; flex-shrink: 0; }

        /* ── Right panel ── */
        .auth-right {
            flex: 0 0 50%; display: flex; align-items: flex-start; justify-content: center;
            padding: clamp(2.5rem, 8vh, 5rem) 2rem 2.5rem; overflow-y: auto; background: #F9FAF8;
        }
        .auth-form-wrap { width: 100%; max-width: 440px; min-height: 540px; display: flex; flex-direction: column; }

        /* ── Tab switcher ── */
        #panelLogin, #panelRegister { flex: 1; }
        .auth-tabs {
            display: flex; background: #F0F0ED; border-radius: 12px;
            padding: 4px; margin-bottom: 2rem; gap: 2px;
        }
        .auth-tab {
            flex: 1; padding: 0.6rem; border: none; border-radius: 9px;
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif; font-size: 1.05rem; font-weight: 500;
            cursor: pointer; transition: all 0.18s; background: transparent; color: #6B7280;
        }
        .auth-tab.active {
            background: #fff; color: #1A1A1A; font-weight: 600;
            box-shadow: 0 1px 6px rgba(0,0,0,0.1);
        }

        /* ── Form elements ── */
        .auth-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem; font-weight: 700; color: #1A1A1A; margin-bottom: 0.25rem;
        }
        .auth-subtitle { font-size: 1.02rem; color: #6B7280; margin-bottom: 1.75rem; }
        .form-label { font-size: 1.02rem; font-weight: 500; color: #374151; margin-bottom: 0.4rem; }
        .form-control {
            border-color: #D1D8E0; border-radius: 9px;
            font-size: 1.02rem; padding: 0.6rem 0.9rem;
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .form-control:focus { border-color: #2C6E49; box-shadow: 0 0 0 3px rgba(44,110,73,0.1); outline: none; }
        .form-control::placeholder { color: #9CA3AF; }
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active {
            font-size: 1.02rem !important;
            font-family: 'Inter', sans-serif !important;
        }
        .input-group .form-control { border-right: none; border-radius: 9px 0 0 9px; }
        .input-group-text {
            background: #fff; border-color: #D1D8E0; border-left: none;
            border-radius: 0 9px 9px 0; cursor: pointer; color: #9CA3AF;
        }
        .input-group-text:hover { color: #6B7280; }
        .text-danger { font-size: 1.14rem; }

        .btn-auth {
            background: #2C6E49; color: #fff; border: none;
            border-radius: 10px; padding: 0.8rem;
            font-size: 1.05rem; font-weight: 600; width: 100%;
            cursor: pointer; font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            transition: background 0.15s;
            display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        }
        .btn-auth:hover { background: #1B4332; }

        .auth-link { font-size: 1.02rem; color: #6B7280; text-align: center; margin-top: 1.25rem; }
        .auth-link a { color: #2C6E49; font-weight: 600; text-decoration: none; cursor: pointer; }
        .auth-link a:hover { text-decoration: underline; }

        .auth-divider { display: flex; align-items: center; gap: 0.75rem; margin: 1.25rem 0; }
        .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: #E8E8E6; }
        .auth-divider span { font-size: 1.2rem; color: #9CA3AF; }

        .btn-social {
            width: 100%; padding: 0.65rem; border: 1.5px solid #E8E8E6;
            border-radius: 9px; background: #fff; font-size: 1.2rem; font-weight: 500;
            color: #1A1A1A; display: flex; align-items: center; justify-content: center;
            gap: 0.65rem; cursor: pointer; transition: border-color 0.15s; text-decoration: none;
        }
        .btn-social:hover { border-color: #B0B0A8; color: #1A1A1A; }

        .demo-card { background: #fff; border: 1px solid #E8E8E6; border-radius: 10px; padding: 1rem 1.1rem; margin-top: 1.5rem; }
        .demo-label { font-size: 0.86rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C4C4BE; margin-bottom: 0.5rem; }
        .demo-row { display: flex; justify-content: space-between; font-size: 1.08rem; margin-bottom: 0.25rem; flex-wrap: wrap; gap: 0.25rem; }
        .demo-role { color: #6B7280; }
        code { font-size: 0.88rem; color: #2C6E49; }

        .check-label { font-size: 1.2rem; color: #374151; }
        .forgot-link { font-size: 1.2rem; color: #2C6E49; text-decoration: none; }
        .forgot-link:hover { text-decoration: underline; }

        @@media (max-width: 768px) {
            html { font-size: 16px; }
            body { flex-direction: column; }
            .auth-left { flex: 0 0 auto; min-height: 200px; padding: 1.75rem; justify-content: flex-end; }
            .auth-left-hint { display: none; }
            .auth-brand { font-size: 1.6rem; margin-bottom: 0; }
            .auth-quote, .auth-tagline, .auth-features { display: none; }
            .auth-right { padding: 1.75rem 1.25rem; align-items: flex-start; }
        }
        @@media (max-width: 480px) {
            html { font-size: 15px; }
            .auth-form-wrap { max-width: 100%; }
            .auth-left { min-height: 160px; }
        }
    </style>
</head>
<body>

<!-- ── Left panel: image + brand (fixed) ── -->
<div class="auth-left">
    <div class="auth-left-content">
        <a asp-controller="Shop" asp-action="Index" class="auth-brand">Pharma<em>Skincare</em></a>
        <div class="auth-quote">"Science-backed skincare you can trust."</div>
        <div class="auth-tagline">Pharmaceutical-grade formulas endorsed by medical professionals — trusted by thousands of customers.</div>
        <div class="auth-features">
            <div class="auth-feature"><i class="bi bi-shield-check"></i> Clinically tested &amp; certified</div>
            <div class="auth-feature"><i class="bi bi-award"></i> Doctor-endorsed formulas</div>
            <div class="auth-feature"><i class="bi bi-truck"></i> Free delivery in Jordan over JD 40</div>
            <div class="auth-feature"><i class="bi bi-arrow-repeat"></i> 30-day hassle-free returns</div>
        </div>
    </div>
</div>

<!-- ── Right panel: tab switcher + forms ── -->
<div class="auth-right">
    <div class="auth-form-wrap">

        <!-- Tab buttons -->
        <div class="auth-tabs">
            <button class="auth-tab" id="tabLogin" onclick="showTab('login')">Sign In</button>
            <button class="auth-tab" id="tabRegister" onclick="showTab('register')">Create Account</button>
        </div>

        <!-- Shared title — updated by JS when switching tabs -->
        <div id="authTitle" class="auth-title">Welcome back</div>
        <div id="authSubtitle" class="auth-subtitle">Sign in to your account to continue</div>

        <!-- ══ LOGIN PANEL ══ -->
        <div id="panelLogin">

            @if (Model.ActiveTab == "login" && !ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:1.2rem;border-radius:9px;border:none;">
                    <div asp-validation-summary="All"></div>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 px-3 mb-3" style="font-size:1.2rem;border-radius:9px;border:none;"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info py-2 px-3 mb-3" style="font-size:1.2rem;border-radius:9px;border:none;">@TempData["Info"]</div>
            }

            @if (ViewBag.HasGoogleAuth == true)
            {
                <!-- Social logins -->
                <div class="d-flex flex-column gap-2 mb-3">
                    <a href="/Account/ExternalLogin?provider=Google&returnUrl=@ViewData["ReturnUrl"]" class="btn-social">
                        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                        Continue with Google
                    </a>
                </div>
                <div class="auth-divider"><span>or sign in with email</span></div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="Email" class="form-control" value="@Model.Login.Email"
                           placeholder="you@example.com" autocomplete="email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <input type="password" name="Password" id="loginPw" class="form-control"
                               placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="input-group-text" onclick="togglePw('loginPw','loginPwIcon')" tabindex="-1">
                            <i class="bi bi-eye" id="loginPwIcon"></i>
                        </button>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check mb-0">
                        <input type="checkbox" name="RememberMe" value="true" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label check-label" for="rememberMe">Remember me</label>
                    </div>
                    <a asp-action="ForgotPassword" class="forgot-link">Forgot password?</a>
                </div>
                <button type="submit" class="btn-auth"><i class="bi bi-box-arrow-in-right"></i> Sign In</button>
            </form>

            <div class="auth-link">
                Don't have an account? <a onclick="showTab('register')">Create one</a>
            </div>

        </div>

        <!-- ══ REGISTER PANEL ══ -->
        <div id="panelRegister" style="display:none;">

            @if (Model.ActiveTab == "register" && !ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:1.2rem;border-radius:9px;border:none;">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">First Name</label>
                        <input type="text" name="FirstName" class="form-control"
                               value="@Model.Register.FirstName" placeholder="John" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Last Name</label>
                        <input type="text" name="LastName" class="form-control"
                               value="@Model.Register.LastName" placeholder="Smith" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="Email" class="form-control"
                               value="@Model.Register.Email" placeholder="john@email.com" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" style="color:#6B7280;">Phone <span style="font-weight:400;">(optional)</span></label>
                        <input type="tel" name="Phone" class="form-control"
                               value="@Model.Register.Phone" placeholder="+962 7 9000 0000" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <input type="password" name="Password" id="regPw" class="form-control" placeholder="Min 8 chars" />
                            <button type="button" class="input-group-text" onclick="togglePw('regPw','regPwIcon')" tabindex="-1">
                                <i class="bi bi-eye" id="regPwIcon"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Confirm</label>
                        <div class="input-group">
                            <input type="password" name="ConfirmPassword" id="regPw2" class="form-control" placeholder="Repeat" />
                            <button type="button" class="input-group-text" onclick="togglePw('regPw2','regPw2Icon')" tabindex="-1">
                                <i class="bi bi-eye" id="regPw2Icon"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn-auth"><i class="bi bi-person-check"></i> Create Account</button>
                </div>
            </form>

            <div class="auth-link">
                Already have an account? <a onclick="showTab('login')">Sign in</a>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
const tabMeta = {
    login:    { title: 'Welcome back',          subtitle: 'Sign in to your account to continue' },
    register: { title: 'Create your account',   subtitle: 'Join PharmaSkincare for exclusive benefits & order tracking' }
};
function showTab(tab) {
    document.getElementById('panelLogin').style.display    = tab === 'login'    ? '' : 'none';
    document.getElementById('panelRegister').style.display = tab === 'register' ? '' : 'none';
    document.getElementById('tabLogin').classList.toggle('active',    tab === 'login');
    document.getElementById('tabRegister').classList.toggle('active', tab === 'register');
    document.getElementById('authTitle').textContent    = tabMeta[tab].title;
    document.getElementById('authSubtitle').textContent = tabMeta[tab].subtitle;
}
function togglePw(inputId, iconId) {
    const i  = document.getElementById(inputId);
    const ic = document.getElementById(iconId);
    i.type = i.type === 'password' ? 'text' : 'password';
    ic.className = 'bi ' + (i.type === 'password' ? 'bi-eye' : 'bi-eye-slash');
}
// Set active tab from server
showTab('@Model.ActiveTab');
</script>
</body>
</html>
