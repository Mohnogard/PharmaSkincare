@model PharmaSkincare.Models.ContactMessage
@{ ViewData["Title"] = "Contact Us"; Layout = "_ShopLayout"; }

<div class="container-shop" style="padding-top:4rem;padding-bottom:5rem;">

    <div style="text-align:center;max-width:580px;margin:0 auto 3.5rem;">
        <div class="section-subtitle mb-2">Get in Touch</div>
        <h1 class="section-title" style="font-size:clamp(1.5rem,5vw,2.75rem);margin-bottom:1rem;">Contact Us</h1>
        <p style="color:var(--ps-mid);font-size:1.2rem;line-height:1.7;">
            Have a question, need advice on a product, or want to discuss a wholesale partnership? We'll get back to you within 24 hours.
        </p>
    </div>

    <div class="row g-5">
        <!-- Contact form -->
        <div class="col-lg-7">
            <div style="background:#fff;border:1px solid var(--ps-border);border-radius:20px;padding:clamp(1.25rem,4vw,2.5rem);">
                <h4 style="font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;">Send us a message</h4>
                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Your Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Ahmad Al-Khalidi" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="jane@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone <span style="color:var(--ps-mid);font-weight:400;">(optional)</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="+962 6 500 0000" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Subject" class="form-label">Subject</label>
                            <select asp-for="Subject" class="form-select">
                                <option value="">Choose a topic…</option>
                                <option>Product Enquiry</option>
                                <option>Order Support</option>
                                <option>Returns &amp; Refunds</option>
                                <option>Partnership / Wholesale</option>
                                <option>Clinical / Medical Enquiry</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label">Your Message</label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="Tell us how we can help…" style="resize:vertical;"></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn-ps" style="padding:0.8rem 2rem;font-size:1.2rem;">
                                <i class="bi bi-send me-2"></i>Send Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Contact info sidebar -->
        <div class="col-lg-5">
            <div class="d-flex flex-column gap-3">
                @foreach (var (icon, color, title, line1, line2) in new[]{
                    ("bi-envelope","var(--ps-primary)","Email Us","support@pharmaskincare.com","We reply within 24 hours"),
                    ("bi-telephone","#1976d2","Call Us","+962 6 500 1000","Sun–Thu, 9am–5pm AST"),
                    ("bi-geo-alt","#d97706","Visit Us","Al-Abdali Boulevard, Amman","Jordan")
                })
                {
                    <div style="background:#fff;border:1px solid var(--ps-border);border-radius:16px;padding:1.5rem;display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:46px;height:46px;background:@(color)15;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi @icon" style="color:@color;font-size:1.1rem;"></i>
                        </div>
                        <div>
                            <div style="font-weight:600;font-size:1.08rem;margin-bottom:0.2rem;">@title</div>
                            <div style="font-size:1.08rem;color:var(--ps-dark);">@line1</div>
                            <div style="font-size:0.96rem;color:var(--ps-mid);">@line2</div>
                        </div>
                    </div>
                }

                <div style="background:var(--ps-primary-light);border-radius:16px;padding:1.5rem;">
                    <div style="font-weight:700;font-size:1.14rem;color:var(--ps-primary);margin-bottom:0.5rem;"><i class="bi bi-clock me-2"></i>Response Times</div>
                    <ul style="font-size:1.02rem;color:#374151;margin:0;padding-left:1rem;line-height:2;">
                        <li>General enquiries — within 24 hours</li>
                        <li>Order issues — within 4 hours</li>
                        <li>Medical / clinical — within 48 hours</li>
                        <li>Partnership enquiries — within 2 business days</li>
                    </ul>
                </div>

                <a asp-controller="Home" asp-action="Support" style="background:#fff;border:1px solid var(--ps-border);border-radius:16px;padding:1.25rem 1.5rem;display:flex;gap:1rem;align-items:center;text-decoration:none;color:var(--ps-dark);transition:box-shadow 0.15s;"
                   onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='none'">
                    <i class="bi bi-question-circle" style="font-size:1.5rem;color:var(--ps-primary);"></i>
                    <div>
                        <div style="font-weight:600;font-size:1.08rem;">Frequently Asked Questions</div>
                        <div style="font-size:0.96rem;color:var(--ps-mid);">Find instant answers in our support centre</div>
                    </div>
                    <i class="bi bi-arrow-right ms-auto" style="color:var(--ps-mid);"></i>
                </a>
            </div>
        </div>
    </div>
</div>
