@model IEnumerable<PharmaSkincare.Models.PharmacyPartner>
@{ ViewData["Title"] = "Where to Find Us"; Layout = "_ShopLayout"; }

<!-- Hero -->
<div style="background:linear-gradient(135deg,#1B4332 0%,#2C6E49 60%);color:#fff;padding:4rem 0 3rem;">
    <div class="container-shop text-center">
        <div class="section-subtitle mb-2" style="color:rgba(255,255,255,0.5);">Our Network</div>
        <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(1.5rem,5vw,2.75rem);font-weight:700;">Where to Find Us</h1>
        <p style="font-size:1.05rem;color:rgba(255,255,255,0.65);max-width:520px;margin:1rem auto 0;line-height:1.7;">
            Find PharmaSkincare at verified pharmacies and wellness centres across Jordan and the region.
        </p>
    </div>
</div>

<div class="container-shop" style="padding-top:3rem;padding-bottom:5rem;">

    <!-- ── Google Maps embed ── -->
    <div style="background:#fff;border:1px solid var(--ps-border);border-radius:20px;overflow:hidden;margin-bottom:3rem;box-shadow:0 4px 24px rgba(0,0,0,0.06);">
        <iframe
            src="https://maps.google.com/maps?q=Amman,Jordan&output=embed&hl=en"
            width="100%"
            height="420"
            style="border:0;display:block;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="PharmaSkincare Headquarters — Amman, Jordan">
        </iframe>
    </div>

    <!-- ── Headquarters note ── -->
    <div style="background:var(--ps-primary-light);border-radius:16px;padding:1.5rem 2rem;margin-bottom:2.5rem;display:flex;align-items:center;gap:1.25rem;">
        <i class="bi bi-building-check" style="font-size:2rem;color:var(--ps-primary);flex-shrink:0;"></i>
        <div>
            <div style="font-weight:700;font-size:1.2rem;color:var(--ps-dark);">Our Headquarters</div>
            <div style="font-size:1.14rem;color:var(--ps-mid);margin-top:0.2rem;">
                PharmaSkincare Ltd, Amman, Jordan &nbsp;·&nbsp;
                <a href="mailto:partners@pharmaskincare.com" style="color:var(--ps-primary);">partners@pharmaskincare.com</a>
            </div>
        </div>
    </div>

    <!-- ── Partner pharmacies ── -->
    @if (Model.Any())
    {
        <div class="section-subtitle mb-1">Authorised Stockists</div>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:700;margin-bottom:1.75rem;color:var(--ps-dark);">Our Pharmacy Partners</h2>
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div style="background:#fff;border:1px solid var(--ps-border);border-radius:16px;padding:1.75rem;height:100%;display:flex;flex-direction:column;gap:1rem;">
                        <div class="d-flex align-items-start gap-3">
                            <div style="width:56px;height:56px;background:var(--ps-primary-light);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-building" style="color:var(--ps-primary);font-size:1.5rem;"></i>
                            </div>
                            <div>
                                <div style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:700;line-height:1.2;">@p.Name</div>
                                @if (!string.IsNullOrEmpty(p.City))
                                {
                                    <div style="font-size:1.14rem;color:var(--ps-mid);margin-top:0.25rem;">
                                        <i class="bi bi-geo-alt me-1"></i>@p.City@(!string.IsNullOrEmpty(p.Country) ? $", {p.Country}" : "")
                                    </div>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(p.ContactPerson) || !string.IsNullOrEmpty(p.Phone) || !string.IsNullOrEmpty(p.Email))
                        {
                            <div style="font-size:1.14rem;color:var(--ps-mid);display:flex;flex-direction:column;gap:0.45rem;">
                                @if (!string.IsNullOrEmpty(p.ContactPerson))
                                {
                                    <span><i class="bi bi-person me-1"></i>@p.ContactPerson</span>
                                }
                                @if (!string.IsNullOrEmpty(p.Phone))
                                {
                                    <a href="tel:@p.Phone" style="color:var(--ps-primary);text-decoration:none;"><i class="bi bi-telephone me-1"></i>@p.Phone</a>
                                }
                                @if (!string.IsNullOrEmpty(p.Email))
                                {
                                    <a href="mailto:@p.Email" style="color:var(--ps-primary);text-decoration:none;"><i class="bi bi-envelope me-1"></i>@p.Email</a>
                                }
                            </div>
                        }

                        <div class="mt-auto pt-2" style="border-top:1px solid var(--ps-border);display:flex;justify-content:space-between;align-items:center;">
                            <span style="background:var(--ps-primary-light);color:var(--ps-primary);border-radius:50px;font-size:1.08rem;font-weight:600;padding:0.3rem 0.85rem;">
                                Verified Stockist
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-building" style="font-size:3rem;color:#C4C4BE;display:block;margin-bottom:1rem;"></i>
            <h4 style="font-family:'Cormorant Garamond',serif;">No partners listed yet</h4>
            <p style="color:var(--ps-mid);">Check back soon or contact us directly.</p>
        </div>
    }

    <!-- ── Become a partner CTA ── -->
    <div style="background:linear-gradient(135deg,#1B4332,#2C6E49);border-radius:20px;padding:clamp(1.5rem,4vw,3rem);text-align:center;margin-top:4rem;color:#fff;">
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(1.4rem,3vw,2rem);font-weight:700;margin-bottom:0.75rem;">Become a Stockist</h2>
        <p style="color:rgba(255,255,255,0.75);font-size:1.05rem;max-width:460px;margin:0 auto 1.5rem;line-height:1.7;">
            Interested in carrying PharmaSkincare in your pharmacy or wellness centre?
            Get in touch with our partnerships team.
        </p>
        <a asp-controller="Home" asp-action="Contact"
           style="display:inline-block;background:#fff;color:#2C6E49;border-radius:10px;padding:0.8rem 2rem;font-weight:700;font-size:1.05rem;text-decoration:none;">
            <i class="bi bi-envelope me-2"></i>Contact Us
        </a>
    </div>
</div>
