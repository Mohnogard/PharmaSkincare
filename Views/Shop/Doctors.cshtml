@model IEnumerable<PharmaSkincare.Models.Doctor>
@{ ViewData["Title"] = "Our Partner Doctors"; Layout = "_ShopLayout"; }

<!-- Hero -->
<div style="background:linear-gradient(135deg,#1B4332 0%,#2C6E49 60%);color:#fff;padding:4.5rem 0 3.5rem;">
    <div class="container-shop text-center">
        <div class="section-subtitle mb-2" style="color:rgba(255,255,255,0.5);">Medical Advisory</div>
        <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(1.5rem,5vw,2.75rem);font-weight:700;">Endorsed by Leading Specialists</h1>
        <p style="font-size:1.05rem;color:rgba(255,255,255,0.65);max-width:560px;margin:1rem auto 0;line-height:1.7;">
            Every PharmaSkincare formula is reviewed and endorsed by leading medical specialists — from consultant dermatologists to sports medicine physicians.
        </p>
    </div>
</div>

<div class="container-shop" style="padding-top:3.5rem;padding-bottom:5rem;">

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var doc in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div style="background:#fff;border:1px solid var(--ps-border);border-radius:18px;padding:2rem;text-align:center;height:100%;display:flex;flex-direction:column;align-items:center;">
                        <!-- Photo -->
                        <div style="width:96px;height:96px;border-radius:50%;overflow:hidden;border:3px solid var(--ps-primary-light);margin-bottom:1rem;flex-shrink:0;">
                            @if (!string.IsNullOrEmpty(doc.ProfileImageUrl))
                            {
                                <img src="@doc.ProfileImageUrl" alt="@doc.Name" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--ps-primary-light);">
                                    <i class="bi bi-person-fill" style="font-size:2.75rem;color:var(--ps-mid);"></i>
                                </div>
                            }
                        </div>
                        <!-- Name & specialty -->
                        <div style="font-family:'Cormorant Garamond',serif;font-weight:700;font-size:1.25rem;margin-bottom:0.25rem;color:var(--ps-dark);">@doc.Name</div>
                        <div style="font-size:1.14rem;color:var(--ps-primary);font-weight:600;margin-bottom:0.25rem;">@doc.Specialty</div>
                        @if (!string.IsNullOrEmpty(doc.Qualification))
                        {
                            <div style="font-size:1.08rem;color:var(--ps-mid);margin-bottom:0.2rem;">@doc.Qualification</div>
                        }
                        @if (!string.IsNullOrEmpty(doc.Hospital))
                        {
                            <div style="font-size:1.08rem;color:var(--ps-mid);margin-bottom:0.75rem;">@doc.Hospital</div>
                        }
                        @if (!string.IsNullOrEmpty(doc.Bio))
                        {
                            <p style="font-size:1.08rem;color:var(--ps-mid);line-height:1.65;text-align:left;margin-top:0.5rem;flex:1;">@doc.Bio</p>
                        }
                        <!-- Endorsement count -->
                        @if (doc.Endorsements.Any(e => e.IsActive))
                        {
                            <div style="margin-top:auto;padding-top:1rem;width:100%;border-top:1px solid var(--ps-border);">
                                <span style="background:var(--ps-primary-light);color:var(--ps-primary);border-radius:50px;font-size:1.08rem;font-weight:600;padding:0.3rem 0.85rem;">
                                    <i class="bi bi-award me-1"></i>@doc.Endorsements.Count(e => e.IsActive) product@(doc.Endorsements.Count(e => e.IsActive) != 1 ? "s" : "") endorsed
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-person-badge" style="font-size:3rem;color:#C4C4BE;display:block;margin-bottom:1rem;"></i>
            <h4 style="font-family:'Cormorant Garamond',serif;">No specialists listed yet</h4>
            <p style="color:var(--ps-mid);">Our medical advisory team is being finalised. Check back soon.</p>
        </div>
    }

    <!-- Healthcare professional CTA -->
    <div style="background:var(--ps-primary-light);border-radius:18px;padding:2.5rem;margin-top:3.5rem;text-align:center;">
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:700;margin-bottom:0.75rem;color:var(--ps-dark);">Are You a Healthcare Professional?</h3>
        <p style="font-size:1.14rem;color:var(--ps-mid);max-width:500px;margin:0 auto 1.25rem;line-height:1.65;">
            We welcome applications from qualified dermatologists, GPs, and pharmacists who share our commitment to evidence-based pharmaceutical skincare.
        </p>
        <a asp-controller="Home" asp-action="Contact" class="btn-ps" style="padding:0.75rem 2rem;">Partner With Us</a>
    </div>
</div>
