@model PharmaSkincare.Models.Subcategory
@using PharmaSkincare.Models
@{ ViewData["Title"] = Model.Name; Layout = "_ShopLayout"; }

@{
    bool hasPurchased = ViewBag.HasPurchasedSubcategory == true;
    var wishlistIds   = ViewBag.WishlistProductIds as HashSet<int> ?? new HashSet<int>();
    var relatedSubs   = ViewBag.RelatedSubcategories as List<Subcategory> ?? new();
    var activeProducts = Model.Products.Where(p => p.IsActive).OrderBy(p => p.FinalPrice).ToList();
    var defaultProduct = activeProducts.FirstOrDefault(p => p.StockQuantity > 0) ?? activeProducts.FirstOrDefault();
    bool hasSizes      = Model.SizeType != SizeType.None && activeProducts.Count > 1;
    bool noProducts    = !activeProducts.Any();

    // Aggregate reviews across all products
    var allReviews = activeProducts.SelectMany(p => p.Reviews.Where(r => r.IsApproved))
                                   .OrderByDescending(r => r.CreatedDate).ToList();
    double avgRating = allReviews.Any() ? allReviews.Average(r => r.Rating) : 0;

    // Main image: subcategory → first product's main image → first gallery image by DisplayOrder
    var firstProductImg = activeProducts.Select(p => p.ImageUrl).FirstOrDefault(u => !string.IsNullOrEmpty(u));
    var firstGalleryImg = activeProducts.SelectMany(p => p.Images).OrderBy(i => i.DisplayOrder).FirstOrDefault()?.ImageUrl;
    string? mainImageUrl = Model.MainImageUrl ?? firstProductImg ?? firstGalleryImg;
}

<div class="container-shop py-5">

    <!-- Breadcrumb -->
    <nav style="font-size:1.02rem;color:var(--ps-mid);margin-bottom:2rem;">
        <a asp-action="Index" style="color:var(--ps-mid);text-decoration:none;">Shop</a>
        <span class="mx-2">›</span>
        @if (Model.Category != null)
        {
            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" style="color:var(--ps-mid);text-decoration:none;">@Model.Category.Name</a>
            <span class="mx-2">›</span>
        }
        <span style="color:var(--ps-dark);font-weight:600;">@Model.Name</span>
    </nav>

    <div class="row g-5">

        <!-- ── Left: Image ── -->
        <div class="col-lg-5">
            <div style="background:#F0F7F2;border-radius:18px;padding:clamp(1.25rem,3vw,2.5rem);display:flex;align-items:center;justify-content:center;min-height:clamp(240px,50vw,380px);">
                @if (!string.IsNullOrEmpty(mainImageUrl))
                {
                    <img id="pdMainImg" src="@mainImageUrl" alt="@Model.Name"
                         style="max-height:340px;object-fit:contain;width:100%;" />
                }
                else
                {
                    <i class="bi bi-droplet-half" style="font-size:6rem;color:#74C69D;opacity:0.5;"></i>
                }
            </div>

            <!-- Thumbnail gallery (from all products) -->
            @{
                var allImages = activeProducts
                    .SelectMany(p => p.Images.Select(img => img.ImageUrl))
                    .Concat(activeProducts.Where(p => !string.IsNullOrEmpty(p.ImageUrl)).Select(p => p.ImageUrl!))
                    .Where(u => !string.IsNullOrEmpty(u))
                    .Distinct()
                    .ToList();
            }
            @if (allImages.Count > 1)
            {
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    @foreach (var imgUrl in allImages.Take(6))
                    {
                        <div onclick="document.getElementById('pdMainImg').src='@imgUrl'"
                             style="width:68px;height:68px;border-radius:10px;background:#F0F7F2;border:2px solid transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;flex-shrink:0;transition:border-color 0.15s;"
                             onmouseover="this.style.borderColor='var(--ps-primary)'" onmouseout="this.style.borderColor='transparent'">
                            <img src="@imgUrl" style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                    }
                </div>
            }

            <!-- Certificates -->
            @{
                var certs = activeProducts.SelectMany(p => p.Certificates.Where(c => c.IsActive)).DistinctBy(c => c.CertificateId).ToList();
            }
            @if (certs.Any())
            {
                <div class="mt-3 d-flex flex-wrap gap-2">
                    @foreach (var cert in certs)
                    {
                        <span style="background:#D8F3DC;color:#2C6E49;border-radius:50px;font-size:0.96rem;font-weight:600;padding:0.25em 0.75em;">
                            <i class="bi bi-shield-check me-1"></i>@cert.CertificateName
                        </span>
                    }
                </div>
            }
        </div>

        <!-- ── Right: Product info ── -->
        <div class="col-lg-7">

            <!-- Category + format badges -->
            <div class="d-flex gap-2 mb-2 flex-wrap">
                <span style="font-size:0.96rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--ps-primary);">
                    @Model.Category?.Name
                </span>
                <span style="color:var(--ps-mid);">·</span>
                <span style="font-size:0.96rem;color:var(--ps-mid);font-weight:600;">@Model.ProductFormat</span>
            </div>

            <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(1.75rem,4vw,2.6rem);font-weight:700;line-height:1.1;margin-bottom:0.75rem;">
                @Model.Name
            </h1>

            @if (allReviews.Any())
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div style="color:#F59E0B;font-size:1.08rem;">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <i class="bi @(s <= Math.Round(avgRating) ? "bi-star-fill" : "bi-star")" style="font-size:1rem;"></i>
                        }
                    </div>
                    <span style="font-size:0.96rem;color:var(--ps-mid);">@avgRating.ToString("0.#") · @allReviews.Count review@(allReviews.Count != 1 ? "s" : "")</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p style="font-size:1.1rem;color:var(--ps-mid);line-height:1.65;margin-bottom:1.25rem;">@Model.Description</p>
            }

            <!-- Formula type + health benefits -->
            <div class="d-flex flex-wrap gap-3 mb-3">
                @if (!string.IsNullOrEmpty(Model.FormulaType))
                {
                    <div style="font-size:0.96rem;">
                        <span style="color:var(--ps-mid);">Formula:</span>
                        <strong style="color:var(--ps-dark);">@Model.FormulaType</strong>
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.HealthBenefits))
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var benefit in Model.HealthBenefits.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span style="background:#D8F3DC;color:#2C6E49;border-radius:50px;font-size:0.9rem;font-weight:600;padding:0.2em 0.65em;">@benefit</span>
                    }
                </div>
            }

            @if (noProducts)
            {
                <div class="alert alert-warning">This product is currently unavailable.</div>
            }
            else
            {
                <!-- ── Size selector (if applicable) ── -->
                @if (hasSizes)
                {
                    <div style="margin-bottom:1.25rem;">
                        <div style="font-weight:700;font-size:1.05rem;margin-bottom:0.6rem;">
                            Select size:
                            <span id="selectedSizeLabel" style="font-weight:400;color:var(--ps-mid);font-size:1rem;"></span>
                        </div>
                        <div class="d-flex flex-wrap gap-2" id="sizeButtons">
                            @foreach (var p in activeProducts)
                            {
                                bool oos = p.StockQuantity == 0;
                                <button type="button"
                                        class="size-btn"
                                        data-product-id="@p.ProductId"
                                        data-size="@(p.Size ?? "—")"
                                        data-price="@p.FinalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                        data-original-price="@p.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                        data-discount="@(p.DiscountPercent ?? 0)"
                                        data-stock="@p.StockQuantity"
                                        data-oos="@oos.ToString().ToLower()"
                                        style="min-width:70px;padding:0.45rem 1rem;border-radius:50px;border:2px solid @(oos ? "#D1D5DB" : "var(--ps-border)");background:@(oos ? "#F9FAFB" : "#fff");font-size:1rem;font-weight:600;cursor:@(oos ? "not-allowed" : "pointer");color:@(oos ? "#9CA3AF" : "var(--ps-dark)");transition:all 0.15s;"
                                        @(oos ? "disabled" : "")>
                                    @(p.Size ?? "—")
                                    @if (oos) { <text> <span style="font-size:0.78rem;font-weight:400;">(sold out)</span></text> }
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- ── Price ── -->
                <div style="margin-bottom:1rem;">
                    <div class="d-flex align-items-baseline gap-3">
                        <span id="priceDisplay" style="font-size:2rem;font-weight:700;color:var(--ps-dark);">
                            JD @(defaultProduct?.FinalPrice.ToString("N2") ?? "—")
                        </span>
                        <span id="originalPriceDisplay" style="font-size:1.2rem;color:#9CA3AF;text-decoration:line-through;display:@(defaultProduct?.HasDiscount == true ? "inline" : "none");">
                            JD @(defaultProduct?.Price.ToString("N2") ?? "")
                        </span>
                        <span id="discountBadge" style="background:#FEF3C7;color:#92400E;border-radius:50px;font-size:0.9rem;font-weight:700;padding:0.2em 0.65em;display:@(defaultProduct?.HasDiscount == true ? "inline" : "none");">
                            Save @(defaultProduct?.DiscountPercent ?? 0)%
                        </span>
                    </div>
                    <div id="stockDisplay" style="font-size:0.96rem;margin-top:0.4rem;">
                        @if (defaultProduct != null)
                        {
                            if (defaultProduct.StockQuantity == 0)
                            {
                                <span style="color:#EF4444;font-weight:600;"><i class="bi bi-x-circle me-1"></i>Out of stock</span>
                            }
                            else if (defaultProduct.StockQuantity <= 5)
                            {
                                <span style="color:#EF4444;font-weight:600;"><i class="bi bi-exclamation-circle me-1"></i>Only @defaultProduct.StockQuantity left</span>
                            }
                            else
                            {
                                <span style="color:#2C6E49;font-weight:600;"><i class="bi bi-check-circle me-1"></i>In stock</span>
                            }
                        }
                    </div>
                </div>

                <!-- ── Add to Cart ── -->
                <form asp-controller="Cart" asp-action="Add" method="post" id="addToCartForm" class="d-flex gap-3 align-items-center flex-wrap mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="cartProductId" name="productId" value="@defaultProduct?.ProductId" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Subcategory", new { id = Model.SubcategoryId })" />
                    <div class="d-flex align-items-center" style="background:#F3F4F6;border-radius:50px;padding:0.2rem 0.2rem 0.2rem 0.75rem;gap:0;">
                        <label style="font-size:1.02rem;font-weight:600;color:var(--ps-dark);white-space:nowrap;">Qty:</label>
                        <input type="number" name="qty" value="1" min="1" max="@defaultProduct?.StockQuantity"
                               id="qtyInput"
                               style="width:56px;border:none;background:transparent;font-size:1.05rem;font-weight:600;text-align:center;padding:0.3rem;" />
                    </div>
                    @if (defaultProduct?.StockQuantity > 0)
                    {
                        <button type="submit" id="addToCartBtn" class="btn-ps" style="font-size:1.05rem;padding:0.7rem 1.75rem;border-radius:50px;">
                            <i class="bi bi-basket2-fill me-2"></i>Add to Basket
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn-ps" id="addToCartBtn" disabled style="opacity:0.5;font-size:1.05rem;padding:0.7rem 1.75rem;border-radius:50px;cursor:not-allowed;">
                            <i class="bi bi-basket2-fill me-2"></i>Out of Stock
                        </button>
                    }
                </form>

                <!-- Wishlist -->
                @if (defaultProduct != null)
                {
                    bool wishlisted = wishlistIds.Contains(defaultProduct.ProductId);
                    <div id="wishlistContainer">
                        @if (User.IsInRole("Customer"))
                        {
                            <form asp-controller="Wishlist" asp-action="Toggle" method="post" id="wishlistForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="wishlistProductId" name="productId" value="@defaultProduct.ProductId" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Subcategory", new { id = Model.SubcategoryId })" />
                                <button type="submit" style="background:none;border:none;cursor:pointer;font-size:1.02rem;color:@(wishlisted ? "#DC2626" : "var(--ps-mid)");padding:0;">
                                    <i class="bi @(wishlisted ? "bi-heart-fill" : "bi-heart") me-1"></i>
                                    @(wishlisted ? "Saved to Wishlist" : "Save to Wishlist")
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" style="font-size:1.02rem;color:var(--ps-mid);text-decoration:none;">
                                <i class="bi bi-heart me-1"></i>Save to Wishlist
                            </a>
                        }
                    </div>
                }
            }

            <!-- Medical disclaimer -->
            <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:12px;padding:0.85rem 1rem;margin-top:1.25rem;font-size:0.96rem;">
                <i class="bi bi-info-circle me-2" style="color:#92400E;"></i>
                <strong style="color:#92400E;">Medical Disclaimer:</strong>
                <span style="color:#78350F;"> This product is not intended to diagnose, treat, cure or prevent any disease. Consult a healthcare professional before use if pregnant, nursing, or on medication.</span>
            </div>
        </div>
    </div>

    <!-- ── Reviews ── -->
    <div style="margin-top:4rem;border-top:1px solid var(--ps-border);padding-top:3rem;">
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.75rem;margin-bottom:1.5rem;">Customer Reviews</h2>

        @if (allReviews.Any())
        {
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="font-size:2rem;font-weight:700;color:var(--ps-dark);">@avgRating.ToString("0.#")</div>
                <div>
                    <div style="color:#F59E0B;font-size:1.2rem;">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <i class="bi @(s <= Math.Round(avgRating) ? "bi-star-fill" : "bi-star")"></i>
                        }
                    </div>
                    <div style="font-size:0.96rem;color:var(--ps-mid);">@allReviews.Count review@(allReviews.Count != 1 ? "s" : "")</div>
                </div>
            </div>
            <div class="row g-3 mb-4">
                @foreach (var review in allReviews.Take(6))
                {
                    <div class="col-md-6">
                        <div style="background:#F8F7F4;border-radius:14px;padding:1.25rem;">
                            <div style="color:#F59E0B;font-size:1rem;margin-bottom:0.4rem;">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <i class="bi @(s <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <p style="font-size:0.96rem;color:var(--ps-dark);line-height:1.6;margin-bottom:0.5rem;">@review.Comment</p>
                            }
                            <div style="font-size:0.88rem;color:var(--ps-mid);">
                                @review.Customer?.FullName — @review.CreatedDate.ToString("MMM yyyy")
                                @if (!string.IsNullOrEmpty(review.Product?.Size))
                                {
                                    <span style="margin-left:0.5rem;background:#E5E7EB;border-radius:50px;padding:0.1em 0.5em;">@review.Product.Size</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color:var(--ps-mid);">No reviews yet for this product.</p>
        }

        <!-- Review form (purchase-gated) -->
        @if (hasPurchased && defaultProduct != null)
        {
            <div style="background:#fff;border:1px solid var(--ps-border);border-radius:16px;padding:1.5rem;max-width:520px;">
                <h5 class="mb-3">Leave a Review</h5>
                <form asp-controller="Shop" asp-action="SubmitReview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="reviewProductId" name="productId" value="@defaultProduct.ProductId" />
                    <div class="mb-3">
                        <label class="form-label fw-600">Rating</label>
                        <div class="d-flex gap-1" id="starRating">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <button type="button" class="star-btn" data-value="@s"
                                        style="background:none;border:none;cursor:pointer;font-size:2rem;color:#D1D5DB;padding:0 2px;line-height:1;transition:color 0.1s;">★</button>
                            }
                        </div>
                        <input type="hidden" name="rating" id="ratingInput" value="5" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-600">Comment <span class="text-muted fw-normal">(optional)</span></label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience…"></textarea>
                    </div>
                    <button type="submit" class="btn-ps" style="padding:0.6rem 1.5rem;">Submit Review</button>
                </form>
            </div>
        }
        else if (!User.Identity!.IsAuthenticated)
        {
            <p style="color:var(--ps-mid);font-size:1.02rem;">
                <a asp-controller="Account" asp-action="Login" style="color:var(--ps-primary);">Sign in</a> to leave a review.
            </p>
        }
        else if (!hasPurchased)
        {
            <p style="color:var(--ps-mid);font-size:0.96rem;"><i class="bi bi-lock me-1"></i>Purchase this product to leave a review.</p>
        }
    </div>

    <!-- ── Related ── -->
    @if (relatedSubs.Any())
    {
        <div style="margin-top:3.5rem;border-top:1px solid var(--ps-border);padding-top:2.5rem;">
            <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.5rem;margin-bottom:1.25rem;">You Might Also Like</h3>
            <div class="row g-3">
                @foreach (var rel in relatedSubs)
                {
                    var relProducts = rel.Products.Where(p => p.IsActive).OrderBy(p => p.FinalPrice).ToList();
                    decimal? relFrom = relProducts.Any() ? relProducts.Min(p => p.FinalPrice) : (decimal?)null;
                    <div class="col-sm-6 col-md-3">
                        <a asp-action="Subcategory" asp-route-id="@rel.SubcategoryId" style="text-decoration:none;color:inherit;">
                            <div class="product-card">
                                <div class="product-card-img">
                                    @if (!string.IsNullOrEmpty(rel.MainImageUrl))
                                    {
                                        <img src="@rel.MainImageUrl" alt="@rel.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-droplet-half" style="font-size:2.5rem;color:#74C69D;opacity:0.5;"></i>
                                    }
                                </div>
                                <div class="product-card-body">
                                    <div class="product-card-name">@rel.Name</div>
                                    @if (relFrom.HasValue)
                                    {
                                        <div class="product-price" style="font-size:1.05rem;">from JD @relFrom.Value.ToString("N2")</div>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

</div>

@section Scripts {
<script>
    // Product data keyed by productId
    const psProducts = {
        @foreach (var p in activeProducts)
        {
            <text>@p.ProductId: { id: @p.ProductId, size: '@(p.Size ?? "—")', price: @p.FinalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), origPrice: @p.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), discount: @(p.DiscountPercent ?? 0), stock: @p.StockQuantity },</text>
        }
    };

    let selectedProductId = @(defaultProduct?.ProductId ?? 0);

    function psSelectProduct(productId) {
        const p = psProducts[productId];
        if (!p) return;
        selectedProductId = productId;

        // Update price
        document.getElementById('priceDisplay').textContent = 'JD ' + parseFloat(p.price).toFixed(2);
        const origEl = document.getElementById('originalPriceDisplay');
        const discEl = document.getElementById('discountBadge');
        if (p.discount > 0) {
            origEl.textContent = 'JD ' + parseFloat(p.origPrice).toFixed(2);
            origEl.style.display = 'inline';
            discEl.textContent = 'Save ' + p.discount + '%';
            discEl.style.display = 'inline';
        } else {
            origEl.style.display = 'none';
            discEl.style.display = 'none';
        }

        // Update stock
        const stockEl = document.getElementById('stockDisplay');
        if (p.stock === 0) {
            stockEl.innerHTML = '<span style="color:#EF4444;font-weight:600;"><i class="bi bi-x-circle me-1"></i>Out of stock</span>';
        } else if (p.stock <= 5) {
            stockEl.innerHTML = '<span style="color:#EF4444;font-weight:600;"><i class="bi bi-exclamation-circle me-1"></i>Only ' + p.stock + ' left</span>';
        } else {
            stockEl.innerHTML = '<span style="color:#2C6E49;font-weight:600;"><i class="bi bi-check-circle me-1"></i>In stock</span>';
        }

        // Update cart form
        document.getElementById('cartProductId').value = productId;
        const btn = document.getElementById('addToCartBtn');
        if (p.stock === 0) {
            btn.disabled = true;
            btn.textContent = '';
            btn.innerHTML = '<i class="bi bi-basket2-fill me-2"></i>Out of Stock';
            btn.style.opacity = '0.5';
            btn.style.cursor = 'not-allowed';
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-basket2-fill me-2"></i>Add to Basket';
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
        }
        const qtyEl = document.getElementById('qtyInput');
        if (qtyEl) qtyEl.max = p.stock;

        // Update wishlist productId if present
        const wlInput = document.getElementById('wishlistProductId');
        if (wlInput) wlInput.value = productId;
        const reviewInput = document.getElementById('reviewProductId');
        if (reviewInput) reviewInput.value = productId;

        // Update size label
        const lbl = document.getElementById('selectedSizeLabel');
        if (lbl) lbl.textContent = p.size;

        // Style buttons
        document.querySelectorAll('.size-btn').forEach(btn => {
            const isSelected = parseInt(btn.dataset.productId) === productId;
            btn.style.borderColor = isSelected ? 'var(--ps-primary)' : (btn.dataset.oos === 'true' ? '#D1D5DB' : 'var(--ps-border)');
            btn.style.background  = isSelected ? '#D8F3DC' : (btn.dataset.oos === 'true' ? '#F9FAFB' : '#fff');
            btn.style.color       = isSelected ? 'var(--ps-primary)' : (btn.dataset.oos === 'true' ? '#9CA3AF' : 'var(--ps-dark)');
        });
    }

    // Wire up size buttons
    document.querySelectorAll('.size-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            if (btn.dataset.oos !== 'true') psSelectProduct(parseInt(btn.dataset.productId));
        });
    });

    // Select default on load
    if (selectedProductId) psSelectProduct(selectedProductId);

    // ── Star rating UI ──
    (function() {
        const starBtns = document.querySelectorAll('#starRating .star-btn');
        if (!starBtns.length) return;
        const ratingInput = document.getElementById('ratingInput');
        let selected = 5;

        function paint(hover) {
            starBtns.forEach((btn, idx) => {
                btn.style.color = idx < hover ? '#F59E0B' : '#D1D5DB';
                btn.style.transform = idx < hover ? 'scale(1.15)' : 'scale(1)';
            });
        }

        starBtns.forEach((btn, idx) => {
            btn.addEventListener('mouseenter', () => paint(idx + 1));
            btn.addEventListener('mouseleave', () => paint(selected));
            btn.addEventListener('click', () => {
                selected = idx + 1;
                if (ratingInput) ratingInput.value = selected;
                paint(selected);
            });
        });

        paint(selected); // initial state: 5 stars highlighted
    }());
</script>
}
