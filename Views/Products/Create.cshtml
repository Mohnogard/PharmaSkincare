@model PharmaSkincare.ViewModels.ProductViewModel
@using PharmaSkincare.Models
@{ ViewData["Title"] = "Add Size Variant"; }

<div class="page-header">
    <h1><i class="bi bi-plus-circle me-2" style="color:var(--ps-primary);"></i>Add Size Variant</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="alert alert-info py-2 mb-3">
    <i class="bi bi-info-circle me-2"></i>
    A size variant belongs to a <strong>subcategory</strong> (e.g. "MagEase Roll-On"). The subcategory holds the name, description and formula — here you set the size, price and stock.
    If the subcategory doesn't exist yet, <a asp-controller="Admin" asp-action="CreateSubcategory">create it first</a>.
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;">Variant Details</h6>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="SubcategoryId" class="form-label"></label>
                        <select asp-for="SubcategoryId" asp-items="Model.Subcategories" class="form-select">
                            <option value="">-- Select Subcategory --</option>
                        </select>
                        <span asp-validation-for="SubcategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Size" class="form-label"></label>
                        <input asp-for="Size" class="form-control" placeholder="e.g. 100ml, 200ml, 30ct" />
                        <div class="form-text">Leave blank if the subcategory has no sizes (SizeType = None).</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SKU" class="form-label"></label>
                        <input asp-for="SKU" class="form-control" placeholder="e.g. MAG-RO-100" />
                        <span asp-validation-for="SKU" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">JD</span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DiscountPercent" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="DiscountPercent" type="number" min="0" max="100" class="form-control" placeholder="0" />
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="form-text">Optional. 10 = 10% off.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;">Inventory</h6>
                <div class="mb-3">
                    <label asp-for="StockQuantity" class="form-label"></label>
                    <input asp-for="StockQuantity" type="number" class="form-control" min="0" />
                </div>
                <div class="mb-3">
                    <label asp-for="MinimumStockLevel" class="form-label"></label>
                    <input asp-for="MinimumStockLevel" type="number" class="form-control" min="0" />
                    <div class="form-text">Alert below this level.</div>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="IsActive" class="form-check-label">Active (visible)</label>
                </div>
            </div>

            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;">Size Image <span class="text-muted fw-400" style="font-size:0.85rem;">(optional)</span></h6>
                <div class="mb-2" id="imagePreviewContainer" style="display:none;">
                    <img id="imagePreview" src="" alt="Preview" class="img-fluid rounded mb-2" style="max-height:160px;object-fit:contain;" />
                </div>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="imageFileInput" onchange="previewImage(this)" />
                <div class="form-text">Shown when this size is selected. Overrides subcategory image.</div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Create Variant</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
function previewImage(input) {
    const container = document.getElementById('imagePreviewContainer');
    const preview = document.getElementById('imagePreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; container.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
