@model PharmaSkincare.ViewModels.ProductViewModel
@using PharmaSkincare.Models
@{ ViewData["Title"] = "Edit Size Variant"; }

<div class="page-header">
    <h1><i class="bi bi-pencil-square me-2" style="color:var(--ps-primary);"></i>Edit Size Variant</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;">Variant Details</h6>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="SubcategoryId" class="form-label"></label>
                        <select asp-for="SubcategoryId" asp-items="Model.Subcategories" class="form-select">
                            <option value="">-- Select Subcategory --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Size" class="form-label"></label>
                        <input asp-for="Size" class="form-control" placeholder="e.g. 100ml, 200ml, 30ct" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SKU" class="form-label"></label>
                        <input asp-for="SKU" class="form-control" />
                        <span asp-validation-for="SKU" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">JD</span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DiscountPercent" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="DiscountPercent" type="number" min="0" max="100" class="form-control" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;">Inventory</h6>
                <div class="mb-3">
                    <label asp-for="StockQuantity" class="form-label"></label>
                    <input asp-for="StockQuantity" type="number" class="form-control" min="0" />
                </div>
                <div class="mb-3">
                    <label asp-for="MinimumStockLevel" class="form-label"></label>
                    <input asp-for="MinimumStockLevel" type="number" class="form-control" min="0" />
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;">Size Image</h6>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Current" class="img-fluid rounded mb-2" style="max-height:130px;object-fit:contain;" />
                    <p class="text-muted small mb-2">Current image</p>
                }
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                <div class="form-text">Leave empty to keep current. Overrides subcategory main image.</div>

                @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                {
                    <div class="mt-3">
                        <label class="form-label fw-600 small">Gallery</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div style="position:relative;width:72px;">
                                    <img src="@img.ImageUrl" style="width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid #ddd;" />
                                    <div class="form-check mt-1" style="font-size:0.75rem;">
                                        <input type="checkbox" name="DeleteImageIds" value="@img.ProductImageId" class="form-check-input" id="del_@img.ProductImageId" />
                                        <label class="form-check-label text-danger" for="del_@img.ProductImageId">Remove</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="mt-2">
                    <label class="form-label fw-600 small">Add Gallery Images</label>
                    <input asp-for="AdditionalImages" type="file" class="form-control" accept="image/*" multiple />
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>
