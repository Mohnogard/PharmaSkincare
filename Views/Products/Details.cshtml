@model PharmaSkincare.Models.Product
@{ ViewData["Title"] = Model.DisplayName; }

<div class="page-header">
    <h1><i class="bi bi-box-seam me-2" style="color:var(--ps-primary);"></i>@Model.DisplayName</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="form-card text-center mb-3">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.DisplayName" class="img-fluid rounded" style="max-height:260px;object-fit:contain;" />
            }
            else
            {
                <div style="height:200px;background:#e8f5f0;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:4rem;color:var(--ps-primary);">
                    <i class="bi bi-box"></i>
                </div>
            }
        </div>
        <div class="form-card mb-3">
            <h6 class="fw-700 mb-3" style="font-weight:700;">Stock Status</h6>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Current Stock</span>
                <span class="fw-600 @(Model.IsLowStock ? "stock-low" : "stock-ok")" style="font-weight:600;">@Model.StockQuantity units</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Minimum Level</span>
                <span>@Model.MinimumStockLevel units</span>
            </div>
            @{ var pct = Model.MinimumStockLevel > 0 ? Math.Min(100, (double)Model.StockQuantity / Model.MinimumStockLevel * 100) : 100; }
            <div class="progress mt-2" style="height:8px;border-radius:4px;">
                <div class="progress-bar @(Model.IsLowStock ? "bg-danger" : "bg-success")" style="width:@pct%;border-radius:4px;"></div>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("WarehouseEmployee"))
            {
                <a asp-controller="Inventory" asp-action="Adjust" asp-route-productId="@Model.ProductId" class="btn btn-sm btn-outline-primary w-100 mt-3">
                    <i class="bi bi-arrows-expand me-1"></i>Adjust Stock
                </a>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="form-card mb-3">
            <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;">Product Information</h6>
            <div class="row g-3">
                <div class="col-md-6"><small class="text-muted d-block">SKU</small><code>@Model.SKU</code></div>
                <div class="col-md-6"><small class="text-muted d-block">Category</small><span class="badge bg-secondary">@Model.Subcategory?.Category?.Name</span></div>
                <div class="col-md-6"><small class="text-muted d-block">Format</small>@Model.Subcategory?.ProductFormat</div>
                <div class="col-md-6"><small class="text-muted d-block">Size</small>@(Model.Size ?? "—")</div>
                <div class="col-md-6"><small class="text-muted d-block">Formula Type</small>@(Model.Subcategory?.FormulaType ?? "—")</div>
                <div class="col-md-6"><small class="text-muted d-block">Price</small><strong style="font-size:1.2rem;color:var(--ps-primary);">JD @Model.Price.ToString("N2")</strong></div>
                <div class="col-md-6"><small class="text-muted d-block">Status</small>
                    @if (Model.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }
                </div>
                <div class="col-md-6"><small class="text-muted d-block">Created</small>@Model.CreatedDate.ToString("dd MMM yyyy")</div>
                @if (!string.IsNullOrEmpty(Model.Subcategory?.Description))
                {
                    <div class="col-12"><small class="text-muted d-block mb-1">Description</small><p class="mb-0">@Model.Subcategory.Description</p></div>
                }
            </div>
        </div>

        @if (Model.Certificates.Any())
        {
            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;"><i class="bi bi-shield-check me-2" style="color:var(--ps-primary);"></i>Certificates</h6>
                @foreach (var cert in Model.Certificates)
                {
                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                        <div>
                            <div style="font-weight:600;font-size:1.05rem;">@cert.CertificateName</div>
                            <small class="text-muted">@cert.IssuingOrganization · Expires @cert.ExpiryDate.ToString("dd MMM yyyy")</small>
                        </div>
                        @if (cert.IsExpired)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                        else if (cert.IsNearingExpiry)
                        {
                            <span class="badge bg-warning text-dark">Expiring Soon</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Valid</span>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.Endorsements.Any())
        {
            <div class="form-card mb-3">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;"><i class="bi bi-award me-2" style="color:#f39c12;"></i>Doctor Endorsements</h6>
                @foreach (var e in Model.Endorsements.Where(e => e.IsActive))
                {
                    <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                        <div style="width:40px;height:40px;background:#e3f2fd;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#1976d2;">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <div style="font-weight:600;font-size:1.05rem;">@e.Doctor?.Name</div>
                            <small class="text-muted">@e.Doctor?.Specialty · @e.EndorsementDate.ToString("dd MMM yyyy")</small>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.Reviews.Any())
        {
            <div class="form-card">
                <h6 class="fw-700 mb-3 pb-2 border-bottom" style="font-weight:700;"><i class="bi bi-star me-2" style="color:#f39c12;"></i>Customer Reviews (@Model.Reviews.Count(r => r.IsApproved))</h6>
                @foreach (var r in Model.Reviews.Where(r => r.IsApproved).Take(5))
                {
                    <div class="py-2 border-bottom">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="text-warning">@string.Concat(Enumerable.Repeat("★", r.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - r.Rating))</span>
                            <small class="text-muted">@r.Customer?.FullName · @r.CreatedDate.ToString("dd MMM yyyy")</small>
                        </div>
                        @if (!string.IsNullOrEmpty(r.Comment)) { <p class="mb-0 small">@r.Comment</p> }
                    </div>
                }
            </div>
        }
    </div>
</div>
