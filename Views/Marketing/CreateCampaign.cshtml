@model PharmaSkincare.Models.Campaign
@using PharmaSkincare.Models
@{ ViewData["Title"] = "New Campaign"; }

<div class="page-header">
    <h1><i class="bi bi-megaphone me-2" style="color:var(--ps-primary);"></i>New Campaign</h1>
    <a asp-action="Campaigns" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-card">
            <form asp-action="CreateCampaign" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="font-size:1.02rem;"></div>
                <div class="row g-3">
                    <div class="col-12"><label class="form-label">Campaign Name</label><input asp-for="Name" class="form-control" placeholder="e.g. Summer Recovery Campaign" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
                    <div class="col-md-6"><label class="form-label">Start Date</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">End Date</label><input asp-for="EndDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Budget (JD)</label><div class="input-group"><span class="input-group-text">JD</span><input asp-for="Budget" type="number" step="0.01" class="form-control" /></div></div>
                    <div class="col-md-6"><label class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var s in Enum.GetValues<CampaignStatus>()) { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div class="col-md-6"><label class="form-label">Target Audience</label><input asp-for="TargetAudience" class="form-control" placeholder="e.g. Athletes 18-45" /></div>
                    <div class="col-md-6"><label class="form-label">Platform</label><input asp-for="Platform" class="form-control" placeholder="e.g. Instagram, Google Ads" /></div>
                    <div class="col-12"><label class="form-label">Campaign Image</label><input type="file" name="imageFile" class="form-control" accept="image/*" /></div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i>Create Campaign</button>
                    <a asp-action="Campaigns" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
