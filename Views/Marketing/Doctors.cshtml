@model IEnumerable<PharmaSkincare.Models.Doctor>
@{ ViewData["Title"] = "Doctors & Specialists"; }

<div class="page-header">
    <div>
        <h1><i class="bi bi-person-badge me-2" style="color:var(--ps-primary);"></i>Medical Advisors</h1>
        <small class="text-muted">@Model.Count() registered doctors</small>
    </div>
    <a asp-action="CreateDoctor" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Doctor</a>
</div>

<div class="row g-3">
    @foreach (var d in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="form-card h-100">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div style="width:52px;height:52px;border-radius:50%;overflow:hidden;flex-shrink:0;border:2px solid var(--ps-border);">
                        @if (!string.IsNullOrEmpty(d.ProfileImageUrl))
                        {
                            <img src="@d.ProfileImageUrl" alt="@d.Name" style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;background:#e3f2fd;display:flex;align-items:center;justify-content:center;color:#1976d2;font-size:1.4rem;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <h6 class="mb-1 fw-700" style="font-weight:700;">@d.Name</h6>
                        <span class="badge bg-light text-dark border" style="font-size:0.96rem;">@d.Specialty</span>
                        @if (!d.IsActive) { <span class="badge bg-secondary ms-1" style="font-size:0.96rem;">Inactive</span> }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(d.Qualification))
                {
                    <div class="mb-2 small text-muted"><i class="bi bi-mortarboard me-1"></i>@d.Qualification</div>
                }
                @if (!string.IsNullOrEmpty(d.Hospital))
                {
                    <div class="mb-1 small text-muted"><i class="bi bi-hospital me-1"></i>@d.Hospital</div>
                }
                @if (!string.IsNullOrEmpty(d.City))
                {
                    <div class="mb-1 small text-muted"><i class="bi bi-geo-alt me-1"></i>@d.City, @d.Country</div>
                }
                @if (!string.IsNullOrEmpty(d.Email))
                {
                    <div class="mb-1 small text-muted"><i class="bi bi-envelope me-1"></i>@d.Email</div>
                }
                <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                    <small class="text-muted">@d.Endorsements.Count endorsements</small>
                    <a asp-action="EditDoctor" asp-route-id="@d.DoctorId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="form-card text-center py-5">
                <i class="bi bi-person-badge fs-1 text-muted opacity-50 d-block mb-3"></i>
                <h5>No doctors registered</h5>
                <a asp-action="CreateDoctor" class="btn btn-primary mt-2">Add First Doctor</a>
            </div>
        </div>
    }
</div>
