@model PharmaSkincare.Models.Endorsement
@{ ViewData["Title"] = "Add Endorsement"; }

<div class="page-header">
    <h1><i class="bi bi-award me-2" style="color:#f39c12;"></i>Add Endorsement</h1>
    <a asp-action="Endorsements" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-action="CreateEndorsement" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Doctor *</label>
                        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select"><option value="">-- Select Doctor --</option></select>
                        <span asp-validation-for="DoctorId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Product *</label>
                        <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select"><option value="">-- Select Product --</option></select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6"><label class="form-label">Endorsement Date</label><input asp-for="EndorsementDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Endorsement Type</label><input asp-for="EndorsementType" class="form-control" placeholder="e.g. Clinical, Personal" /></div>
                    <div class="col-md-6"><label class="form-label">Document / Certificate</label><input type="file" name="documentFile" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
                    <div class="col-auto"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" type="checkbox" checked /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i>Add Endorsement</button>
                    <a asp-action="Endorsements" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
