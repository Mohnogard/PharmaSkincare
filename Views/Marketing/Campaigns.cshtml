@model IEnumerable<PharmaSkincare.Models.Campaign>
@using PharmaSkincare.Models
@{ ViewData["Title"] = "Campaigns"; }

<div class="page-header">
    <div>
        <h1><i class="bi bi-megaphone me-2" style="color:var(--ps-primary);"></i>Marketing Campaigns</h1>
        <small class="text-muted">@Model.Count() campaigns</small>
    </div>
    <a asp-action="CreateCampaign" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New Campaign</a>
</div>

<div class="row g-3">
    @foreach (var c in Model)
    {
        var statusClass = c.Status switch {
            CampaignStatus.Active => "bg-success",
            CampaignStatus.Draft => "bg-secondary",
            CampaignStatus.Paused => "bg-warning text-dark",
            CampaignStatus.Completed => "bg-primary",
            _ => "bg-danger"
        };
        var spent = c.Budget > 0 ? (double)c.AmountSpent / (double)c.Budget * 100 : 0;
        <div class="col-lg-6">
            <div class="form-card">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <h6 class="fw-700 mb-1" style="font-weight:700;">@c.Name</h6>
                        <small class="text-muted">@c.StartDate.ToString("dd MMM") – @c.EndDate.ToString("dd MMM yyyy")</small>
                    </div>
                    <span class="badge @statusClass">@c.Status</span>
                </div>

                @if (!string.IsNullOrEmpty(c.Description))
                {
                    <p class="text-muted small mb-3" style="max-height:50px;overflow:hidden;">@c.Description</p>
                }

                <div class="row g-2 mb-3">
                    <div class="col-4 text-center">
                        <div style="font-size:1.2rem;font-weight:700;color:var(--ps-primary);">@c.Impressions.ToString("N0")</div>
                        <div class="text-muted" style="font-size:0.96rem;text-transform:uppercase;">Impressions</div>
                    </div>
                    <div class="col-4 text-center">
                        <div style="font-size:1.2rem;font-weight:700;color:#1976d2;">@c.Clicks.ToString("N0")</div>
                        <div class="text-muted" style="font-size:0.96rem;text-transform:uppercase;">Clicks</div>
                    </div>
                    <div class="col-4 text-center">
                        <div style="font-size:1.2rem;font-weight:700;color:#27ae60;">@c.Conversions</div>
                        <div class="text-muted" style="font-size:0.96rem;text-transform:uppercase;">Conversions</div>
                    </div>
                </div>

                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Budget used</small>
                        <small><strong>JD @c.AmountSpent.ToString("N0")</strong> / JD @c.Budget.ToString("N0")</small>
                    </div>
                    <div class="progress" style="height:6px;border-radius:3px;">
                        <div class="progress-bar @(spent > 90 ? "bg-danger" : "bg-primary")" style="width:@Math.Min(100, spent)%;border-radius:3px;"></div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(c.Platform))
                {
                    <div class="mt-2 mb-3"><small class="text-muted"><i class="bi bi-globe2 me-1"></i>@c.Platform</small></div>
                }

                <a asp-action="EditCampaign" asp-route-id="@c.CampaignId" class="btn btn-sm btn-outline-primary w-100">
                    <i class="bi bi-pencil me-1"></i>Edit Campaign
                </a>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="form-card text-center py-5">
                <i class="bi bi-megaphone fs-1 text-muted opacity-50 d-block mb-3"></i>
                <h5>No campaigns yet</h5>
                <a asp-action="CreateCampaign" class="btn btn-primary">Create Your First Campaign</a>
            </div>
        </div>
    }
</div>
