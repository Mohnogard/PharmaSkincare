@model PharmaSkincare.Models.Certificate
@{ ViewData["Title"] = "Edit Certificate"; }

<div class="page-header">
    <h1><i class="bi bi-pencil-square me-2" style="color:var(--ps-primary);"></i>Edit Certificate</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CertificateId" />
                <div class="row g-3">
                    <div class="col-12"><label class="form-label">Certificate Name</label><input asp-for="CertificateName" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Issuing Organization</label><input asp-for="IssuingOrganization" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Certificate Number</label><input asp-for="CertificateNumber" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Certificate Type</label><input asp-for="CertificateType" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Issue Date</label><input asp-for="IssueDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Associated Product</label><select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products"><option value="">— Company-wide —</option></select></div>
                    <div class="col-12">
                        <label class="form-label">Replace Document</label>
                        @if (!string.IsNullOrEmpty(Model.FilePath)) { <div class="mb-1"><a href="@Model.FilePath" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark me-1"></i>View Current</a></div> }
                        <input type="file" name="certFile" class="form-control" />
                    </div>
                    <div class="col-auto"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i>Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
