@model PharmaSkincare.Models.Certificate
@{ ViewData["Title"] = "Add Certificate"; }

<div class="page-header">
    <h1><i class="bi bi-shield-plus me-2" style="color:var(--ps-primary);"></i>Add Certificate</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="font-size:1.02rem;"></div>
                <div class="row g-3">
                    <div class="col-12"><label class="form-label">Certificate Name *</label><input asp-for="CertificateName" class="form-control" /><span asp-validation-for="CertificateName" class="text-danger small"></span></div>
                    <div class="col-12"><label class="form-label">Issuing Organization *</label><input asp-for="IssuingOrganization" class="form-control" /><span asp-validation-for="IssuingOrganization" class="text-danger small"></span></div>
                    <div class="col-md-6"><label class="form-label">Certificate Number</label><input asp-for="CertificateNumber" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Certificate Type</label><input asp-for="CertificateType" class="form-control" placeholder="e.g. Safety, Manufacturing, Ethics" /></div>
                    <div class="col-md-6"><label class="form-label">Issue Date *</label><input asp-for="IssueDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Expiry Date *</label><input asp-for="ExpiryDate" type="date" class="form-control" /></div>
                    <div class="col-12">
                        <label class="form-label">Associated Product (optional)</label>
                        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products">
                            <option value="">— Company-wide Certificate —</option>
                        </select>
                    </div>
                    <div class="col-12"><label class="form-label">Upload Document</label><input type="file" name="certFile" class="form-control" /><div class="form-text">PDF, JPG, PNG accepted. Max 5MB.</div></div>
                    <div class="col-auto"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" type="checkbox" checked /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-shield-check me-1"></i>Add Certificate</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
